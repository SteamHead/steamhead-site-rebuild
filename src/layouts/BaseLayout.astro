---
/*
  BaseLayout.astro — shared HTML shell for all pages.
  Props:
    title       (string) — page <title>
    description (string) — meta description
    currentPath (string) — used to mark active nav link
*/
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = "SteamHead is a nonprofit maker education organisation delivering hands-on, project-based STEAM programs.",
  currentPath = Astro.url.pathname,
} = Astro.props;

// Organization structured data — legal name is "SteamHead" (no "LLC"),
// per the 2026-06-22 founders' resolution of the legal-entity question.
// EIN sourced from the /form-990-n/ transparency page.
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "SteamHead",
  legalName: "SteamHead",
  url: "https://steamhead.space",
  logo: "https://steamhead.space/images/branding/sh-logo-horizontal.png",
  description: "SteamHead is a 501(c)(3) nonprofit maker education organisation, founded in 2011, delivering hands-on, project-based STEAM programs for students and educators.",
  foundingDate: "2011",
  taxID: "82-4533355",
  sameAs: [
    "https://www.facebook.com/groups/steamhead.space",
  ],
  contactPoint: {
    "@type": "ContactPoint",
    email: "james@steamhead.space",
    contactType: "general inquiries",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} — SteamHead</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} — SteamHead`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="icon" type="image/png" href="/favicon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body>

    <Header currentPath={currentPath} />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

  </body>
</html>
