---
/* Header component — sticky black nav bar with SteamHead branding */
const programLinks = [
  { href: "/makefashion-edu/",    label: "MakeFashion Edu" },
  { href: "/neighborhood-earth/", label: "Neighborhood Earth" },
  { href: "/system-upgrade/",     label: "System Upgrade" },
];
const navLinks = [
  { href: "/",          label: "Home" },
  { href: "/about-us/", label: "About Us" },
  { href: "/blog/",     label: "Blog" },
  { href: "/shelf/",    label: "The Shelf" },
];

const { currentPath = "/" } = Astro.props;
const inPrograms = programLinks.some(l => currentPath === l.href);
---

<header class="site-header">
  <nav class="container site-nav" aria-label="Main navigation">

    <!-- Logo -->
    <a href="/" class="site-logo" aria-label="SteamHead — Make Great Things">
      <img
        src="/images/branding/sh-logo-horizontal.png"
        alt="SteamHead — Make Great Things"
        height="46"
      />
    </a>

    <!-- Mobile toggle -->
    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="nav-menu">
      <span></span><span></span><span></span>
    </button>

    <!-- Nav links -->
    <ul class="nav-links" id="nav-menu" role="list">
      <li>
        <a href="/" class:list={["nav-link", { "nav-link--active": currentPath === "/" }]}>Home</a>
      </li>
      <li>
        <a href="/about-us/" class:list={["nav-link", { "nav-link--active": currentPath === "/about-us/" }]}>About Us</a>
      </li>

      <li class="nav-dropdown">
        <button
          class:list={["nav-link", "nav-dropdown__toggle", { "nav-link--active": inPrograms }]}
          aria-expanded="false"
          aria-controls="programs-menu"
        >
          Programs <span class="nav-dropdown__caret" aria-hidden="true">▾</span>
        </button>
        <ul class="nav-dropdown__menu" id="programs-menu" role="list">
          {programLinks.map(link => (
            <li>
              <a
                href={link.href}
                class:list={["nav-link", { "nav-link--active": currentPath === link.href }]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </li>

      <li>
        <a href="/blog/" class:list={["nav-link", { "nav-link--active": currentPath.startsWith("/blog") }]}>Blog</a>
      </li>
      <li>
        <a href="/shelf/" class:list={["nav-link", { "nav-link--active": currentPath === "/shelf/" }]}>The Shelf</a>
      </li>
    </ul>

  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-nav-bg);
    border-bottom: 2px solid var(--color-dark-border);
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: var(--nav-height);
    flex-wrap: wrap;
  }

  /* Logo — the image has the same black background as the bar, so it blends */
  .site-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .site-logo img {
    height: 46px;
    width: auto;
    display: block;
  }

  /* Nav links */
  .nav-links {
    display: flex;
    align-items: center;
    list-style: none;
    gap: var(--space-sm);
    padding: 0;
    margin: 0;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-gray-mid);
    text-decoration: none;
    padding: 0.3rem 0.5rem;
    border-radius: var(--radius);
    transition: color 0.15s, background 0.15s;
    white-space: nowrap;
    background: none;
    border: none;
    cursor: pointer;
  }
  .nav-link:hover,
  .nav-link--active {
    color: var(--color-yellow);
    opacity: 1;
  }

  /* Programs dropdown */
  .nav-dropdown {
    position: relative;
  }
  .nav-dropdown__caret {
    font-size: 0.7em;
    display: inline-block;
    transition: transform 0.15s;
  }
  .nav-dropdown.is-open .nav-dropdown__caret {
    transform: rotate(180deg);
  }
  .nav-dropdown__menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    background: var(--color-nav-bg);
    border: 1px solid var(--color-dark-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-pop);
    flex-direction: column;
    gap: 0.15rem;
  }
  .nav-dropdown.is-open .nav-dropdown__menu {
    display: flex;
  }
  .nav-dropdown__menu .nav-link {
    display: block;
  }

  /* Mobile toggle button */
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-white);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  @media (max-width: 900px) {
    .nav-toggle { display: flex; }

    .nav-links {
      display: none;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      padding: var(--space-sm) 0 var(--space-sm);
      border-top: 1px solid var(--color-dark-border);
      gap: 0;
    }
    .nav-links.is-open { display: flex; }

    .nav-link { padding: 0.6rem 0; display: block; width: 100%; text-align: left; }

    /* Dropdown flattens to an indented section on mobile */
    .nav-dropdown__menu {
      position: static;
      border: none;
      box-shadow: none;
      padding: 0 0 0 var(--space-sm);
      min-width: 0;
    }

    .site-nav {
      flex-wrap: wrap;
      height: auto;
      padding-block: 0.75rem;
    }
    .site-logo img { height: 40px; }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const menu   = document.querySelector('.nav-links');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
  });

  const dropdown = document.querySelector('.nav-dropdown');
  const dropToggle = document.querySelector('.nav-dropdown__toggle');
  dropToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = dropdown?.classList.toggle('is-open');
    dropToggle.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (e) => {
    if (dropdown?.classList.contains('is-open') && !dropdown.contains(e.target as Node)) {
      dropdown.classList.remove('is-open');
      dropToggle?.setAttribute('aria-expanded', 'false');
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && dropdown?.classList.contains('is-open')) {
      dropdown.classList.remove('is-open');
      dropToggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
