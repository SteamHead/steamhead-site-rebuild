---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('mfedu');
  // Run the Program is a numbered sequence; each step page gets the list
  const steps = pages
    .filter(p => p.data.section === 'run-the-program')
    .sort((a, b) => a.data.order - b.data.order);
  return pages.map(page => ({
    params: { slug: page.id },
    props: { page, steps: page.data.section === 'run-the-program' ? steps : [] },
  }));
}

const { page, steps } = Astro.props;
const { Content } = await render(page);
const sectionLabel = {
  'runway-shows': 'Runway Shows',
  'run-the-program': 'Run the Program',
  'resources': 'Resources',
  'about': 'About',
}[page.data.section];
const stepIndex = steps.findIndex(s => s.id === page.id);
const prev = steps[stepIndex - 1];
const next = steps[stepIndex + 1];
// Only Runway Shows has an index page to link back to
const sectionHref = page.data.section === 'runway-shows' && page.id !== 'runwayshows'
  ? '/makefashion-edu/runwayshows/'
  : undefined;
---

<BaseLayout
  title={`${page.data.title} — MakeFashion Edu`}
  description={page.data.description ?? `${page.data.title} — part of MakeFashion Edu, run by SteamHead.`}
>

  <section class="hero hero--short" aria-label={page.data.title}>
    <div class="container hero__content">
      <p class="mfedu-crumb">
        <a href="/makefashion-edu/">MakeFashion Edu</a> / {sectionHref ? <a href={sectionHref}>{sectionLabel}</a> : sectionLabel}
      </p>
      <h1>{page.data.title}</h1>
    </div>
  </section>

  <section class="section" aria-label="Page content">
    <div class="container">
      <article class="mfedu-body">
        <Content />
      </article>
    </div>
  </section>

  {steps.length > 0 && (
    <nav class="section section--alt" aria-labelledby="steps-heading">
      <div class="container">
        <h2 id="steps-heading" class="steps__heading">
          Run the Program · Step {stepIndex + 1} of {steps.length}
        </h2>
        <ol class="steps__list">
          {steps.map(s => (
            <li>
              {s.id === page.id
                ? <span aria-current="page">{s.data.title}</span>
                : <a href={`/makefashion-edu/${s.id}/`}>{s.data.title}</a>}
            </li>
          ))}
        </ol>
        <div class="steps__pager">
          {prev && (
            <a class="steps__link" href={`/makefashion-edu/${prev.id}/`}>
              <span class="steps__dir">← Previous</span>
              <span>{prev.data.title}</span>
            </a>
          )}
          {next ? (
            <a class="steps__link steps__link--next" href={`/makefashion-edu/${next.id}/`}>
              <span class="steps__dir">Next →</span>
              <span>{next.data.title}</span>
            </a>
          ) : (
            <a class="steps__link steps__link--next" href="/makefashion-edu/resources/">
              <span class="steps__dir">Next →</span>
              <span>Resources: videos, logo and stickers</span>
            </a>
          )}
        </div>
      </div>
    </nav>
  )}

</BaseLayout>

<style>
  /* Run the Program step navigation */
  .steps__heading {
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
  }
  .steps__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    padding-left: 1.25rem;
    margin-bottom: var(--space-md);
  }
  .steps__list li { padding-right: var(--space-sm); }
  .steps__list [aria-current] { font-weight: 700; }
  .steps__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }
  @media (max-width: 640px) { .steps__pager { grid-template-columns: 1fr; } }
  .steps__link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: var(--space-sm);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-dark);
  }
  .steps__link--next { grid-column: 2; text-align: right; }
  @media (max-width: 640px) { .steps__link--next { grid-column: auto; } }
  .steps__dir {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* No hero photo here, so drop the global 4:3 photo-hero sizing (which
     leaves a near-full-screen empty band on desktop) and size to the title */
  .hero--short {
    padding-block: var(--space-lg);
    aspect-ratio: auto;
    min-height: 0;
  }

  .mfedu-crumb {
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: var(--space-xs);
  }
  .mfedu-crumb a {
    color: var(--color-yellow);
  }

  .mfedu-body :global(h2) { margin-top: var(--space-md); margin-bottom: var(--space-xs); }
  .mfedu-body :global(h3) { margin-top: var(--space-md); margin-bottom: var(--space-xs); }
  .mfedu-body :global(p)  { margin-bottom: var(--space-sm); }
  .mfedu-body :global(ul),
  .mfedu-body :global(ol) { margin-bottom: var(--space-sm); }

  /* Show facts (Runway Shows): Where / When / Theme at the top of each show */
  .mfedu-body :global(.show-facts) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    margin: 0 0 var(--space-md);
    padding: var(--space-sm) 0;
    border-block: 1px solid var(--color-border);
  }
  .mfedu-body :global(.show-facts dt) {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .mfedu-body :global(.show-facts dd) {
    margin: 0;
    font-weight: 600;
  }

  /* Gallery treatment: any paragraph that is a run of images becomes a grid */
  .mfedu-body :global(p:has(> img)) {
    /* galleries span the full content width; prose keeps the global 68ch measure */
    max-width: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: var(--space-sm);
  }
  .mfedu-body :global(p:has(> img)) :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
    margin: 0;
  }
  /* a paragraph with exactly one image keeps natural proportions */
  .mfedu-body :global(p:has(> img:only-child)) {
    display: block;
  }
  .mfedu-body :global(p:has(> img:only-child)) :global(img) {
    aspect-ratio: auto;
    max-width: 100%;
    width: auto;
  }

  /* Location cards (Runway Shows): one .card per city, photo on top,
     links to that city's shows as chips underneath */
  .mfedu-body :global(.location-cards) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-md);
    margin-block: var(--space-md);
  }
  .mfedu-body :global(.location-cards .card) {
    border: 1px solid var(--color-border);
  }
  .mfedu-body :global(.location-cards .card__image) {
    aspect-ratio: 4 / 3;
    object-position: center 25%;
    margin: 0;
  }
  .mfedu-body :global(.location-cards .card__title) {
    margin: 0;
  }
  .mfedu-body :global(.location-cards .card__text) {
    font-size: var(--text-sm);
    margin: 0;
  }
  .mfedu-body :global(.show-links) {
    list-style: none;
    padding: 0;
    margin: var(--space-xs) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .mfedu-body :global(.show-links a) {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-link);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .mfedu-body :global(.show-links a:hover),
  .mfedu-body :global(.show-links a:focus-visible) {
    background: var(--color-link);
    color: var(--color-white);
  }

  /* Logo wall (Supporters & Friends): logos contained on white tiles,
     never cropped, with the organization name captioned underneath */
  .mfedu-body :global(.logo-wall) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-sm);
    margin-block: var(--space-md);
  }
  .mfedu-body :global(.logo-wall figure) {
    margin: 0;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .mfedu-body :global(.logo-wall img) {
    width: 100%;
    height: 80px;
    object-fit: contain;
    border-radius: 0;
    margin: 0;
  }
  .mfedu-body :global(.logo-wall figcaption) {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: auto;
  }
</style>
