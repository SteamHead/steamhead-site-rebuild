---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'home');
const { hero_heading, hero_tagline, impact_stats } = entry.data;
---

<BaseLayout
  title={hero_heading}
  description={hero_tagline}
>

  <!-- =====================================================================
       HERO
       ===================================================================== -->
  <section class="hero" aria-label="Introduction">
    <img
      class="hero__bg"
      src="/images/2025/05/20221004_095453326_iOS-scaled.jpg"
      alt="Educators and a student sharing a laugh over colored-pencil artwork in class"
    />
    <div class="container hero__content">
      <h1>{hero_heading}</h1>
      <p class="hero__tagline">{hero_tagline}</p>
      <a href="/about-us/" class="btn btn--primary">About SteamHead</a>
    </div>
  </section>

  <!-- =====================================================================
       OUR INITIATIVES
       ===================================================================== -->
  <section class="section" aria-label="Our initiatives">
    <div class="container">
      <div class="section__header">
        <h2>Our Initiatives</h2>
        <p>
          Our initiatives reflect SteamHead's belief that meaningful learning happens
          through participation, making, and shared discovery.
        </p>
      </div>

      <div class="card-grid">

        <!-- Neighborhood Earth -->
        <article class="card card--earth">
          <img
            class="card__image"
            src="/images/2024/04/neighborhoodearth.jpg"
            alt="Neighborhood Earth initiative"
          />
          <div class="card__body">
            <h3 class="card__title">Neighborhood Earth</h3>
            <p class="card__text">
              Global educator exchanges and place-based learning projects. We connect
              educators and learning communities around the world to share practices,
              ideas, and locally rooted STEAM projects that reflect environmental and
              cultural contexts.
            </p>
          </div>
          <div class="card__footer">
            <a href="/neighborhood-earth/" class="btn btn--outline" aria-label="Learn more about Neighborhood Earth">Learn More</a>
          </div>
        </article>

        <!-- System Upgrade -->
        <article class="card card--upgrade">
          <img
            class="card__image"
            src="/images/2024/04/systemupgrade.jpg"
            alt="System Upgrade initiative"
          />
          <div class="card__body">
            <h3 class="card__title">System Upgrade</h3>
            <p class="card__text">
              Rethinking education through authentic learning experiences. System Upgrade
              explores how schools can move beyond traditional instruction toward
              project-based, learner-driven models that prioritise curiosity, relevance,
              and real-world problem-solving.
            </p>
          </div>
          <div class="card__footer">
            <a href="/system-upgrade/" class="btn btn--outline" aria-label="Learn more about System Upgrade">Learn More</a>
          </div>
        </article>

        <!-- MakeFashion Edu -->
        <article class="card card--mfedu">
          <img
            class="card__image"
            src="/images/2024/04/makefashionedu.jpg"
            alt="MakeFashion Edu initiative"
          />
          <div class="card__body">
            <h3 class="card__title">MakeFashion Edu</h3>
            <p class="card__text">
              Advocacy, identity, and technology through fashion. MakeFashion Edu
              integrates design, wearable technology, and social themes to help learners
              explore identity, sustainability, and creative expression through making.
            </p>
          </div>
          <div class="card__footer">
            <a href="/makefashion-edu/" class="btn btn--outline" aria-label="Learn more about MakeFashion Edu">Learn More</a>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- =====================================================================
       IMPACT SNAPSHOT
       ===================================================================== -->
  <section class="section section--alt" aria-label="Our impact">
    <div class="container">
      <div class="section__header">
        <h2>Our Impact</h2>
      </div>
      <div class="stat-grid">
        {(impact_stats ?? []).map((s: { number: string; label: string }) => (
          <div class="stat-tile">
            <span class="stat-tile__number">{s.number}</span>
            <span class="stat-tile__label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       METHODOLOGY
       ===================================================================== -->
  <section class="section section--alt" aria-label="Our methodology">
    <div class="container">
      <div class="section__header">
        <h2>Our Methodology</h2>
        <p>
          SteamHead's approach is rooted in maker-centered pedagogy, where learning
          emerges through exploration, iteration, and reflection rather than passive
          instruction.
        </p>
      </div>

      <div class="method-grid">
        <div class="method-item">
          <h3>Hands-On Engagement</h3>
          <p>
            Learners engage directly with tools, materials, and technologies — from
            digital fabrication to low-tech prototyping — building practical skills
            alongside conceptual understanding.
          </p>
        </div>
        <div class="method-item">
          <h3>Real Questions, Real Projects</h3>
          <p>
            Projects are designed around real questions and challenges, encouraging
            learners to think critically, collaborate meaningfully, and take ownership
            of their work.
          </p>
        </div>
        <div class="method-item">
          <h3>Educator Support &amp; Capacity Building</h3>
          <p>
            We work alongside educators to help them adopt maker-centered teaching
            practices, offering resources, workshops, and shared frameworks that
            support long-term impact.
          </p>
        </div>
        <div class="method-item">
          <h3>Access to Resources</h3>
          <p>
            Improving access to resources is central to SteamHead's mission, as it
            underpins all meaningful makerspace and project-based learning.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       COMMUNITY
       ===================================================================== -->
  <section class="section section--dark" aria-label="Community engagement">
    <div class="container">
      <div class="two-col">
        <div>
          <h2>Community Engagement</h2>
          <hr class="accent-rule" />
          <p>
            SteamHead believes that learning is strongest when it is social, inclusive,
            and embedded in community.
          </p>
          <p>
            Through workshops, open studios, school partnerships, and collaborative
            events, we create spaces where learners of all ages can experiment, share
            ideas, and learn from one another. These experiences strengthen not only
            technical skills, but also communication, empathy, and confidence.
          </p>
          <p>
            We work with schools, educators, families, and organisations to design
            learning experiences that respond to local needs while connecting to
            global conversations in education.
          </p>
        </div>
        <img
          src="/images/2018/09/2017-11-SH-Nerdy-Derby-2.jpg"
          alt="A mentor and young makers building wooden derby cars in the makerspace"
        />
      </div>
    </div>
  </section>

  <!-- =====================================================================
       LONG-TERM COLLABORATION / ACCESS
       ===================================================================== -->
  <section class="section" aria-label="Long-term collaboration">
    <div class="container">
      <h2>Grounded in Long-Term Collaboration</h2>
      <hr class="accent-rule" />
      <div class="two-col mt-md">
        <p>
          Across the communities we serve, we consistently encounter learners who are
          capable, motivated, and curious, yet limited by unequal access to tools,
          resources, and supportive learning environments. In many cases, experimentation
          and initiative are discouraged not due to lack of ability, but because of
          structural constraints.
        </p>
        <p>
          SteamHead's work is grounded in long-term collaboration with schools and
          learning communities. It engages students, educators, families, and a broader
          international network of partners, including museums, researchers, and fellow
          makerspaces.
        </p>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       ONLINE PROJECT GUIDES CTA
       ===================================================================== -->
  <section class="section section--alt" aria-label="Online project guides">
    <div class="container">
      <div class="two-col">
        <div>
          <h2>Online Project Guides</h2>
          <hr class="accent-rule" />
          <p>
            SteamHead's online project guides support educators and facilitators looking
            to bring makerspace learning into their own contexts.
          </p>
          <p>
            Our guides focus on practical strategies, project design, and reflective
            teaching practices — making them suitable for teachers, school leaders, and
            community educators seeking flexible, self-paced professional learning.
          </p>
          <a href="/theshelf/" class="btn btn--primary mt-md">Browse Guides &amp; Resources</a>
        </div>
        <img
          src="/images/2021/08/GettingStartedWithMFEDU.jpg"
          alt="Getting Started with MakeFashion Edu project guide"
        />
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SUPPORT CTA
       ===================================================================== -->
  <section class="section" aria-label="Support SteamHead">
    <div class="container support-cta">
      <h2>Support Our Work</h2>
      <hr class="accent-rule" />
      <p class="mt-md">
        SteamHead is a 501(c)(3) nonprofit that runs on grants, donations, and
        volunteer time. Whether you're a funder exploring a partnership or want
        to give directly, we'd love to hear from you.
      </p>
      <div class="cta-row mt-md">
        <a href="/funders-partnerships/" class="btn btn--primary">Funders &amp; Partnerships</a>
        <a href="/contact-us/" class="btn btn--outline">Get in Touch</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-md);
  }
  .stat-tile {
    text-align: center;
    padding: var(--space-md);
    background: var(--color-dark-surface);
    border-radius: var(--radius);
    border-top: 4px solid var(--color-yellow);
  }
  .stat-tile__number {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    color: var(--color-yellow);
    line-height: 1.1;
  }
  .stat-tile__label {
    display: block;
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    color: var(--color-gray-light);
  }

  .support-cta { max-width: 70ch; }
  .cta-row {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* Initiative accent color behind the card body/footer, matching each
     initiative's mockup color. */
  .card--earth   { background: var(--color-init-earth); }
  .card--upgrade { background: var(--color-init-upgrade); }
  .card--mfedu   { background: var(--color-init-mfedu); }

  /* On these solid-color card bodies, the brand burnt-orange heading and
     button outline read poorly — use plain black instead. */
  .card--earth .card__title,
  .card--upgrade .card__title,
  .card--mfedu .card__title,
  .card--earth .card__text,
  .card--upgrade .card__text,
  .card--mfedu .card__text {
    color: var(--color-black);
  }
  .card--earth .btn--outline,
  .card--upgrade .btn--outline,
  .card--mfedu .btn--outline {
    border-color: transparent;
    color: var(--color-black);
  }
  .card--earth .btn--outline:hover,
  .card--upgrade .btn--outline:hover,
  .card--mfedu .btn--outline:hover {
    background: transparent;
    color: var(--color-black);
  }
  .card--earth .card__footer,
  .card--upgrade .card__footer,
  .card--mfedu .card__footer {
    text-align: center;
  }

  .method-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-md);
  }
  .method-item h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-xs);
  }
  .method-item h3::after {
    content: "";
    display: block;
    width: 2.5rem;
    height: 3px;
    background: var(--color-yellow);
    margin-top: 0.4rem;
  }
</style>
