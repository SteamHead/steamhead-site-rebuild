---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Make Great Things"
  description="SteamHead is a nonprofit maker education organisation that partners with schools and learning communities to deliver hands-on, project-based STEAM programs."
>

  <!-- =====================================================================
       HERO
       ===================================================================== -->
  <section class="hero" aria-label="Introduction">
    <img
      class="hero__bg"
      src="/images/2025/05/20221004_095453326_iOS-scaled.jpg"
      alt="Students working in a makerspace"
    />
    <div class="container hero__content">
      <h1>Make Great Things</h1>
      <p class="hero__tagline">
        SteamHead is a nonprofit maker education organisation that partners with schools
        and learning communities to deliver hands-on, project-based STEAM programs.
      </p>
      <a href="/about-us/" class="btn btn--primary">About SteamHead</a>
    </div>
  </section>

  <!-- =====================================================================
       ABOUT BLURB
       ===================================================================== -->
  <section class="section" aria-label="About SteamHead">
    <div class="container">
      <div class="two-col">
        <div>
          <h2>Who We Are</h2>
          <hr class="accent-rule" />
          <p>
            SteamHead designs and delivers makerspace learning experiences that help students
            become confident problem-solvers, creative thinkers, and active participants in
            their own education.
          </p>
          <p>
            Our programs integrate science, technology, engineering, arts, and mathematics
            (STEAM) through hands-on projects that encourage experimentation, collaboration,
            and real-world thinking — whether in classrooms, community spaces, or informal
            learning environments.
          </p>
        </div>
        <img
          src="/images/2021/04/20181019_1855150-scaled.jpg"
          alt="SteamHead community gathering"
        />
      </div>
    </div>
  </section>

  <!-- =====================================================================
       OUR INITIATIVES
       ===================================================================== -->
  <section class="section section--alt" aria-label="Our initiatives">
    <div class="container">
      <div class="section__header">
        <h2>Our Initiatives</h2>
        <p>
          Our initiatives reflect SteamHead's belief that meaningful learning happens
          through participation, making, and shared discovery.
        </p>
      </div>

      <div class="card-grid">

        <!-- Neighborhood Earth -->
        <article class="card">
          <img
            class="card__image"
            src="/images/2024/04/neighborhoodearth.png"
            alt="Neighborhood Earth initiative"
          />
          <div class="card__body">
            <h3 class="card__title">Neighborhood Earth</h3>
            <p class="card__text">
              Global educator exchanges and place-based learning projects. We connect
              educators and learning communities around the world to share practices,
              ideas, and locally rooted STEAM projects.
            </p>
          </div>
          <div class="card__footer">
            <a href="/neighborhood-earth/" class="btn btn--outline">Learn More</a>
          </div>
        </article>

        <!-- System Upgrade -->
        <article class="card">
          <img
            class="card__image"
            src="/images/2024/04/systemupgrade.png"
            alt="System Upgrade initiative"
          />
          <div class="card__body">
            <h3 class="card__title">System Upgrade</h3>
            <p class="card__text">
              Rethinking education through authentic learning experiences. System Upgrade
              explores how schools can move toward project-based, learner-driven models
              that prioritise curiosity and real-world problem-solving.
            </p>
          </div>
          <div class="card__footer">
            <a href="/system-upgrade/" class="btn btn--outline">Learn More</a>
          </div>
        </article>

        <!-- MakeFashion Edu -->
        <article class="card">
          <img
            class="card__image"
            src="/images/2024/04/makefashionedu.png"
            alt="MakeFashion Edu initiative"
          />
          <div class="card__body">
            <h3 class="card__title">MakeFashion Edu</h3>
            <p class="card__text">
              Advocacy, identity, and technology through fashion. MakeFashion Edu
              integrates design, wearable technology, and social themes to help learners
              explore identity, sustainability, and creative expression.
            </p>
          </div>
          <div class="card__footer">
            <a href="/makefashion-edu/" class="btn btn--outline">Learn More</a>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- =====================================================================
       METHODOLOGY
       ===================================================================== -->
  <section class="section" aria-label="Our methodology">
    <div class="container">
      <h2>Our Methodology</h2>
      <hr class="accent-rule" />
      <div class="two-col mt-md">
        <div>
          <p>
            SteamHead's approach is rooted in maker-centered pedagogy, where learning
            emerges through exploration, iteration, and reflection rather than passive
            instruction.
          </p>
          <p>
            Learners engage directly with tools, materials, and technologies — from
            digital fabrication to low-tech prototyping — building practical skills
            alongside conceptual understanding.
          </p>
          <p>
            Projects are designed around real questions and challenges, encouraging
            learners to think critically, collaborate meaningfully, and take ownership
            of their work.
          </p>
        </div>
        <div>
          <p>
            We work alongside educators to help them adopt maker-centered teaching
            practices, offering resources, workshops, and shared frameworks that support
            long-term impact.
          </p>
          <p>
            Improving access to resources is central to SteamHead's mission, as it
            underpins all meaningful makerspace and project-based learning.
          </p>
          <p>
            Our work engages students, educators, families, and a broader international
            network of partners, including museums, researchers, and fellow makerspaces.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       COMMUNITY
       ===================================================================== -->
  <section class="section section--dark" aria-label="Community engagement">
    <div class="container">
      <div class="two-col">
        <div>
          <h2>Community Engagement</h2>
          <hr class="accent-rule" />
          <p>
            SteamHead believes that learning is strongest when it is social, inclusive,
            and embedded in community.
          </p>
          <p>
            Through workshops, open studios, school partnerships, and collaborative
            events, we create spaces where learners of all ages can experiment, share
            ideas, and learn from one another.
          </p>
          <p>
            These experiences strengthen not only technical skills, but also
            communication, empathy, and confidence.
          </p>
        </div>
        <img
          src="/images/2018/09/2017-11-SH-Nerdy-Derby-2.jpg"
          alt="Community makerspace event"
        />
      </div>
    </div>
  </section>

  <!-- =====================================================================
       ONLINE COURSES CTA
       ===================================================================== -->
  <section class="section section--alt" aria-label="Online courses">
    <div class="container">
      <div class="section__header">
        <h2>Online STEAM &amp; Makerspace Courses</h2>
        <p>
          SteamHead's online courses support educators and facilitators looking to bring
          makerspace learning into their own contexts.
        </p>
      </div>
      <p>
        Our courses focus on practical strategies, project design, and reflective teaching
        practices — making them suitable for teachers, school leaders, and community
        educators seeking flexible, self-paced professional learning.
      </p>
      <a href="/shop/" class="btn btn--primary mt-md">Browse Courses &amp; Resources</a>
    </div>
  </section>

</BaseLayout>
