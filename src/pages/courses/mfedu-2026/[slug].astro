---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

/* One lesson of Advocacy by Design (2026). Auto-marks complete on visit;
   the pill under the title unchecks. Progress key:
   'course-progress:mfedu-2026'. */

export async function getStaticPaths() {
  const lessons = (await getCollection('courses', c => c.data.course === 'mfedu-2026'))
    .sort((a, b) => a.data.order - b.data.order);
  return lessons.map((lesson, i) => ({
    params: { slug: lesson.id.split('/').pop()! },
    props: {
      lesson,
      prev: lessons[i - 1] ?? null,
      next: lessons[i + 1] ?? null,
      total: lessons.length,
    },
  }));
}

const { lesson, prev, next, total } = Astro.props;
const { Content } = await render(lesson);
const { title, order, section, description, badge } = lesson.data;
const slugOf = (id: string) => id.split('/').pop();
---

<BaseLayout
  title={`${title} — Advocacy by Design`}
  description={description ?? `Lesson ${order} of Advocacy by Design, the 2026 MakeFashion Edu course.`}
>

  <section class="hero hero--short" aria-label={title}>
    <div class="container hero__content">
      <p class="lesson-crumb">
        <a href="/courses/mfedu-2026/">Advocacy by Design</a>
        &nbsp;/&nbsp; Lesson {order} of {total} · {section}
      </p>
      <h1>{title}</h1>
      <div class="lesson-meta">
        <button class="done-pill" data-done-toggle data-lesson={slugOf(lesson.id)} type="button">
          Marked complete — tap to unmark
        </button>
        {badge && (
          <a class="badge-chip" href="/maker-badges/" title="The Maker Badges pathway this lesson feeds">
            Badge pathway: {badge}
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="section" aria-label="Lesson content">
    <div class="container lesson-body">
      <Content />
    </div>
  </section>

  <section class="section section--alt" aria-label="Lesson navigation">
    <div class="container lesson-nav">
      {prev ? (
        <a class="lesson-nav__link" href={`/courses/mfedu-2026/${slugOf(prev.id)}/`}>
          <span class="lesson-nav__dir">← Previous</span>
          <span>{prev.data.title}</span>
        </a>
      ) : (
        <a class="lesson-nav__link" href="/courses/mfedu-2026/">
          <span class="lesson-nav__dir">← Course Home</span>
          <span>Lesson index</span>
        </a>
      )}
      <a class="lesson-nav__home" href="/courses/mfedu-2026/">All lessons</a>
      {next ? (
        <a class="lesson-nav__link lesson-nav__link--next" href={`/courses/mfedu-2026/${slugOf(next.id)}/`}>
          <span class="lesson-nav__dir">Next →</span>
          <span>{next.data.title}</span>
        </a>
      ) : (
        <a class="lesson-nav__link lesson-nav__link--next" href="/courses/mfedu-2026/">
          <span class="lesson-nav__dir">Finish →</span>
          <span>Back to the course page</span>
        </a>
      )}
    </div>
  </section>

</BaseLayout>

<script>
  const KEY = 'course-progress:mfedu-2026';
  const btn = document.querySelector<HTMLElement>('[data-done-toggle]');
  const slug = btn?.dataset.lesson ?? '';

  const read = (): Record<string, boolean> => {
    try { return JSON.parse(localStorage.getItem(KEY) ?? '{}'); }
    catch { return {}; }
  };
  const write = (p: Record<string, boolean>) =>
    localStorage.setItem(KEY, JSON.stringify(p));

  function paint() {
    const done = !!read()[slug];
    btn?.classList.toggle('done-pill--done', done);
    if (btn) btn.textContent = done
      ? '✓ Marked complete — tap to unmark'
      : 'Not complete — tap to mark done';
  }

  if (slug) {
    const p = read();
    if (!p[slug]) { p[slug] = true; write(p); }
  }
  paint();

  btn?.addEventListener('click', () => {
    const p = read();
    if (p[slug]) delete p[slug]; else p[slug] = true;
    write(p);
    paint();
  });
</script>

<style>
  .hero--short { padding-block: var(--space-lg); }

  .lesson-crumb {
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: var(--space-xs);
  }
  .lesson-crumb a { color: var(--color-yellow); text-decoration: none; }

  .lesson-meta {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    flex-wrap: wrap;
    margin-top: var(--space-sm);
  }
  .done-pill {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid var(--color-dark-border);
    background: var(--color-dark-surface);
    color: var(--color-text-dim);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    cursor: pointer;
  }
  .done-pill--done {
    background: var(--color-yellow);
    border-color: var(--color-yellow);
    color: var(--color-black);
  }
  .badge-chip {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-teal);
    border: 1px solid var(--color-teal);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    text-decoration: none;
  }

  .lesson-body { max-width: 75ch; }
  .lesson-body :global(h2) { margin-top: var(--space-md); margin-bottom: var(--space-xs); }
  .lesson-body :global(h3) { margin-top: var(--space-md); margin-bottom: var(--space-xs); }
  .lesson-body :global(p)  { margin-bottom: var(--space-sm); }
  .lesson-body :global(ul),
  .lesson-body :global(ol) { margin-bottom: var(--space-sm); }
  .lesson-body :global(blockquote) {
    border-left: 4px solid var(--color-yellow);
    background: var(--color-gray-light);
    border-radius: var(--radius);
    padding: var(--space-sm) var(--space-md);
    margin-block: var(--space-sm);
    color: var(--color-dark);
  }
  .lesson-body :global(blockquote p) { margin: 0 0 var(--space-xs); }
  .lesson-body :global(blockquote p:last-child) { margin: 0; }
  .lesson-body :global(img) { margin-block: var(--space-sm); }

  .lesson-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-sm);
    align-items: center;
  }
  @media (max-width: 640px) { .lesson-nav { grid-template-columns: 1fr; } }
  .lesson-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: var(--space-sm);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-dark);
  }
  .lesson-nav__link--next { text-align: right; }
  .lesson-nav__dir {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .lesson-nav__home { font-size: var(--text-sm); font-weight: 600; }
</style>
