---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, getCollection, render } from 'astro:content';
import { personHasPage } from '../lib/people';

const entry = await getEntry('pages', 'about');
const { Content } = await render(entry);
const { mission, vision, values, funding } = entry.data;

/* People grids: everyone appears as a card; profiles with written content
   link to their page at /people/<slug>/ (see src/lib/people.ts). */
const people = (await getCollection('people', p => !p.data.draft))
  .map(p => ({ ...p, hasPage: personHasPage(p) }))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const team = people.filter(p => p.data.role === 'team');
const residents = people.filter(p => p.data.role === 'resident');
---

<BaseLayout
  title="About Us"
  description="SteamHead is a network of people, spaces, and events who collaborate to improve equity in education as the path forward."
>

  <!-- =====================================================================
       HERO
       ===================================================================== -->
  <section class="hero hero--short" aria-label="About Us">
    <img
      class="hero__bg"
      src="/images/2021/04/20181019_1855150-scaled.jpg"
      alt="SteamHead community group photo around a project table at an evening meetup"
    />
    <div class="container hero__content">
      <h1>About Us</h1>
      <p class="hero__tagline">
        A network of people, spaces, and events collaborating to improve equity
        in education as the path forward.
      </p>
    </div>
  </section>

  <!-- =====================================================================
       MISSION / VISION / VALUES
       ===================================================================== -->
  <section class="section" aria-label="Mission, Vision, and Values">
    <div class="container">
      <div class="mvv-grid">

        <div class="mvv-card">
          <h2>Our Mission</h2>
          <hr class="accent-rule" />
          <p>{mission}</p>
        </div>

        <div class="mvv-card">
          <h2>Our Vision</h2>
          <hr class="accent-rule" />
          <p>{vision}</p>
        </div>

        <div class="mvv-card">
          <h2>Our Values</h2>
          <hr class="accent-rule" />
          <ul>
            {values.map((v: string) => <li>{v}</li>)}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- =====================================================================
       ABOUT THE ORGANISATION
       ===================================================================== -->
  <section class="section section--alt" aria-label="About the organisation">
    <div class="container">
      <div class="two-col">
        <div>
          <h2>Who We Are</h2>
          <hr class="accent-rule" />
          <Content />
        </div>
        <img
          src="/images/2018/08/shbridge-logo2.jpg"
          alt="SteamHead makerspace interior with 3D printer, workbenches, and the SteamHead logo"
        />
      </div>
    </div>
  </section>

  <!-- =====================================================================
       OPEN COLLABORATION
       ===================================================================== -->
  <section class="section" aria-label="Open collaboration">
    <div class="container">
      <h2>Open Collaboration</h2>
      <hr class="accent-rule" />
      <div class="two-col mt-md">
        <p>
          In the SteamHead community, teachers and parents can freely exchange teaching
          materials, strategies, and perspectives. This open sharing is seen as crucial
          for creating a more enriched educational environment, allowing teachers to
          learn from each other's successes and challenges.
        </p>
        <p>
          Through a culture of openness and teamwork, SteamHead aims to empower educators
          by providing a supportive network that enhances the quality of education for
          students worldwide.
        </p>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       TEAM
       ===================================================================== -->
  <section class="section section--alt" aria-label="Our team">
    <div class="container">
      <h2>Our Team</h2>
      <hr class="accent-rule" />
      <p class="mt-md">
        Founded by James Simpson and Carrie Leung, SteamHead is built by educators,
        makers, parents, experts, and collaborators from around the world.
        Our residents and team members each contribute to the space and community —
        many becoming continuous contributors over time.
      </p>

      {[
        { label: 'Team', group: team },
        { label: 'Residents', group: residents },
      ].map(({ label, group }) => (
        <>
          <h3 class="people-group">{label}</h3>
          <div class="people-grid">
            {group.map(p =>
              p.hasPage ? (
                <a class="person-card person-card--link" href={`/people/${p.id}/`}>
                  {p.data.image && (
                    <img src={p.data.image} alt={p.data.imageAlt ?? p.data.name} loading="lazy" />
                  )}
                  <div class="person-card__body">
                    <span class="person-card__name">{p.data.name}</span>
                    <span class="person-card__more">Read profile →</span>
                  </div>
                </a>
              ) : (
                <div class="person-card">
                  {p.data.image && (
                    <img src={p.data.image} alt={p.data.imageAlt ?? p.data.name} loading="lazy" />
                  )}
                  <div class="person-card__body">
                    <span class="person-card__name">{p.data.name}</span>
                  </div>
                </div>
              )
            )}
          </div>
        </>
      ))}
    </div>
  </section>

  <!-- =====================================================================
       FUNDING
       ===================================================================== -->
  <section class="section section--dark" aria-label="Funding and sustainability">
    <div class="container">
      <h2>Funding</h2>
      <hr class="accent-rule" />
      <p class="mt-md">{funding}</p>
    </div>
  </section>

  <!-- =====================================================================
       JOIN THE COMMUNITY
       ===================================================================== -->
  <section class="section" aria-label="Join the community">
    <div class="container">
      <h2>Join the Community</h2>
      <hr class="accent-rule" />
      <p class="mt-md">
        Educators, did you know that Hackers are lifelong learners contributing educational
        content to their communities? Hackers, did you know teachers from Kindergarten
        through University are advocating for the skills and values in your makerspaces
        to be brought into schools?
      </p>
      <p>
        Join us online to discuss and support each other. No experience required — all
        levels of Educators and Hackers welcome.
      </p>
      <a href="/contact-us/" class="btn btn--primary mt-md">
        Get in Touch
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  .hero--short { padding-block: var(--space-lg); }

  .mvv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-md);
  }

  .mvv-card {
    padding: var(--space-md);
    background: var(--color-gray-light);
    border-radius: var(--radius);
    border-top: 4px solid var(--color-yellow);
  }
  .mvv-card h2 { font-size: var(--text-2xl); margin-bottom: var(--space-xs); }
  .mvv-card ul { margin-top: var(--space-xs); color: var(--color-dark); }
  .mvv-card li { margin-bottom: 0.4rem; }

  /* --- People grids --- */
  .people-group {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    color: var(--color-dark);
  }
  .people-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--space-sm);
  }
  .person-card {
    display: block;
    background: var(--color-white);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
  }
  .person-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 0;
  }
  .person-card__body {
    padding: var(--space-xs);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .person-card__name {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-dark);
    line-height: 1.3;
  }
  /* Linked cards = a profile page exists; the yellow tag is the indicator. */
  .person-card--link {
    box-shadow: var(--shadow-card);
    transition: transform 0.12s, box-shadow 0.12s;
  }
  .person-card--link:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-pop);
    opacity: 1;
  }
  .person-card__more {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-black);
    background: var(--color-yellow);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    align-self: flex-start;
    margin-top: 0.2rem;
  }
</style>
