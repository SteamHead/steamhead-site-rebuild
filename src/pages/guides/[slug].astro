---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map(guide => ({
    params: { slug: guide.id },
    props:  { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const { title, description } = guide.data;
---

<BaseLayout title={title} description={description}>

  <section class="guide-hero section--dark" aria-label={title}>
    <div class="container">
      <p class="guide-kicker">Course Guide</p>
      <h1>{title}</h1>
      <p class="guide-description">{description}</p>
      <a href="/theshelf/" class="btn btn--outline mt-md">← Back to The Shelf</a>
    </div>
  </section>

  <section class="section" aria-label="Guide content">
    <div class="container">
      <div class="guide-body">
        <Content />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .guide-hero {
    background: var(--color-black);
    padding-block: var(--space-lg);
    border-bottom: 3px solid var(--color-yellow);
  }
  .guide-kicker {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-yellow);
    margin-bottom: var(--space-xs);
  }
  .guide-hero h1 {
    color: var(--color-white);
    font-size: var(--text-4xl);
    margin-bottom: var(--space-sm);
  }
  .guide-description {
    color: var(--color-text-dim);
    max-width: 60ch;
    line-height: 1.7;
  }

  /* Readable document layout */
  .guide-body {
    max-width: 72ch;
    line-height: 1.8;
    color: var(--color-dark);
  }
  .guide-body :global(h2) {
    font-size: var(--text-2xl);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 2px solid var(--color-yellow);
  }
  .guide-body :global(h3) {
    font-size: var(--text-xl);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-xs);
    color: var(--color-teal);
  }
  .guide-body :global(h4) {
    font-size: var(--text-base);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
  }
  .guide-body :global(p) {
    margin-bottom: var(--space-sm);
  }
  .guide-body :global(ul),
  .guide-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: var(--space-sm);
  }
  .guide-body :global(li) {
    margin-bottom: 0.35rem;
  }
  .guide-body :global(blockquote) {
    border-left: 4px solid var(--color-teal);
    margin: var(--space-md) 0;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-gray-light);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-style: italic;
  }
  .guide-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-lg) 0;
  }
  .guide-body :global(strong) {
    color: var(--color-dark);
  }
  .guide-body :global(a) {
    color: var(--color-teal);
    text-underline-offset: 3px;
  }
  .guide-body :global(a:hover) {
    color: var(--color-yellow);
    opacity: 1;
  }
</style>
