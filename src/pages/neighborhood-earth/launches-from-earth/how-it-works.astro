    background: var(--color-white);
    padding: var(--space-sm);
    display: grid;
    gap: 0.15rem;
  }
  .part-name { font-weight: 700; color: var(--color-heading); }
  .part-role { font-size: var(--text-sm); color: var(--color-text-muted); }

  /* ---- pull note ---- */
  .note {
    border-left: 3px solid var(--color-init-earth);
    padding: 0.25rem 0 0.25rem var(--space-sm);
    margin-block: var(--space-md);
  }
  .note p { color: var(--color-text-muted); margin-bottom: 0; }

  /* ---- question list ---- */
  .qs { display: grid; gap: var(--space-xs); margin-block: var(--space-sm); }

  /* ---- prompt block ---- */
  .prompt {
    background: var(--color-gray-light);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-sm);
    margin-block: var(--space-md);
    display: grid;
    gap: var(--space-sm);
  }
  .prompt pre {
    margin: 0;
    overflow-x: auto;
    font-size: var(--text-sm);
    line-height: 1.6;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-dark);
  }
  .prompt__actions { display: flex; align-items: center; gap: var(--space-sm); flex-wrap: wrap; }
  .copied { font-size: var(--text-sm); color: var(--color-text-muted); }

  /* ---- diagram ---- */
  .diagram { margin: var(--space-md) 0; display: grid; gap: var(--space-sm); justify-items: center; }
  .diagram__scroll { width: 100%; overflow-x: auto; display: flex; justify-content: center; }
  .diagram svg { width: 100%; max-width: 480px; height: auto; }
  .diagram figcaption {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 60ch;
    text-align: center;
  }
  .dg-zone {
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 1;
    stroke-dasharray: 5 4;
  }
