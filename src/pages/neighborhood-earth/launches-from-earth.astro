---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'launches-from-earth');
const { Content } = await render(entry);
const {
  hero_tagline,
  guiding_question,
  why_body,
  learn_intro,
  learn_questions,
  how_heading,
  how_body,
  classroom_body,
  limitations_body,
  github_url,
} = entry.data;

const paragraphs = (text: string) =>
  String(text ?? '').trim().split(/\n\s*\n/).filter(Boolean);
---

<BaseLayout
  title="Launches from Earth"
  description="An interactive globe for exploring upcoming space launches around the world — where they happen, when they launch, and what they reveal about our increasingly connected planet."
>

  <!-- =====================================================================
       HERO
       ===================================================================== -->
  <section class="hero" aria-label="Launches from Earth">
    <div class="container hero__content">
      <p class="text-muted" style="color: var(--color-gray-light);">
        <a href="/neighborhood-earth/" style="color: var(--color-yellow);">Neighborhood Earth</a>
        · a project by SteamHead
      </p>
      <h1>Launches from Earth</h1>
      <p class="hero__tagline">{hero_tagline}</p>
      <a href="#explore" class="btn btn--primary">Explore the globe</a>
      <a href={github_url} class="btn btn--outline" target="_blank" rel="noopener">View on GitHub</a>
    </div>
  </section>

  <!-- =====================================================================
       1. EXPLORE THE GLOBE
       ===================================================================== -->
  <section class="section" id="explore" aria-label="Explore the globe">
    <div class="container">
      <div class="section__header">
        <h2>Explore the globe</h2>
        <p>{guiding_question}</p>
      </div>
      <div class="app-embed">
        <iframe
          src="/projects/launches-from-earth/"
          title="Launches from Earth — interactive globe of upcoming space launches"
          loading="lazy"
        ></iframe>
      </div>
      <p class="text-muted mt-md">
        Having trouble with the embed? <a href="/projects/launches-from-earth/" target="_blank" rel="noopener">Open it full-screen in a new tab</a>.
      </p>
    </div>
  </section>

  <!-- =====================================================================
       2. WHY WE MADE IT
       ===================================================================== -->
  <section class="section section--alt" aria-label="Why we made it">
    <div class="container">
      <div class="two-col">
        <div>
          <h2>Why we made it</h2>
          <hr class="accent-rule" />
          {paragraphs(why_body).map((t: string) => <p>{t}</p>)}
          <div class="text-muted"><Content /></div>
        </div>

        <aside class="peek" aria-labelledby="peek-title">
          <figure class="peek__fig">
            <svg viewBox="0 0 560 300" role="img" aria-label="Seen from above the pole: points on the near half of the globe project across to the flat picture the page draws, while points on the far half are dropped.">
              <defs>
                <marker id="pk-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M0 0 L10 5 L0 10 z" class="pk-head" />
                </marker>
              </defs>
              <text x="20" y="20" class="pk-cap">SEEN FROM ABOVE THE POLE</text>

              <circle cx="180" cy="160" r="98" class="pk-box" />
              <line x1="180" y1="54" x2="180" y2="266" class="pk-dash" />
              <text x="180" y="286" class="pk-s">the edge of what you can see</text>

              <line x1="418" y1="52" x2="418" y2="272" class="pk-line" />
              <text x="418" y="42" class="pk-s">the flat picture</text>

              <circle cx="236" cy="82" r="5" class="pk-pin" />
              <line x1="241" y1="82" x2="414" y2="82" class="pk-dash" />
              <circle cx="418" cy="82" r="4" class="pk-pin" />

              <circle cx="278" cy="160" r="5" class="pk-pin" />
              <line x1="283" y1="160" x2="414" y2="160" class="pk-dash" />
              <circle cx="418" cy="160" r="4" class="pk-pin" />

              <circle cx="244" cy="234" r="5" class="pk-pin" />
              <line x1="249" y1="234" x2="414" y2="234" class="pk-dash" />
              <circle cx="418" cy="234" r="4" class="pk-pin" />

              <circle cx="104" cy="226" r="5" class="pk-gone" />
              <circle cx="104" cy="106" r="5" class="pk-gone" />
              <text x="128" y="156" class="pk-s">the far side</text>
              <text x="128" y="172" class="pk-s">is dropped</text>

              <line x1="524" y1="160" x2="474" y2="160" class="pk-line" marker-end="url(#pk-arrow)" />
              <text x="532" y="164" class="pk-e">you</text>
            </svg>
          </figure>

          <h3 id="peek-title">{how_heading}</h3>
          {paragraphs(how_body).map((t: string) => <p>{t}</p>)}
          <a href="/neighborhood-earth/launches-from-earth/how-it-works/" class="btn btn--primary">
            How this works
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       3. WHAT YOU CAN LEARN
       ===================================================================== -->
  <section class="section" aria-label="What you can learn">
    <div class="container">
      <h2>What you can learn</h2>
      <hr class="accent-rule" />
      <p>{learn_intro}</p>
      <ul>
        {learn_questions.map((q: string) => <li>{q}</li>)}
      </ul>
    </div>
  </section>

  <!-- =====================================================================
       4. USE IT IN A CLASSROOM
       ===================================================================== -->
  <section class="section" aria-label="Use it in a classroom">
    <div class="container">
      <h2>Use it in a classroom</h2>
      <hr class="accent-rule" />
      <p>{classroom_body}</p>
    </div>
  </section>

  <!-- =====================================================================
       5. VIEW OR CONTRIBUTE ON GITHUB
       ===================================================================== -->
  <section class="section section--alt" aria-label="View or contribute on GitHub">
    <div class="container">
      <h2>View or contribute on GitHub</h2>
      <hr class="accent-rule" />
      <p>
        The source code is publicly available so that others can study, adapt, improve, and
        build upon the project — it's a single self-contained HTML file with no build step.
      </p>
      <a href={github_url} class="btn btn--primary" target="_blank" rel="noopener">
        github.com/SteamHead/earth-launches
      </a>
    </div>
  </section>

  <!-- =====================================================================
       6. KNOWN DATA LIMITATIONS
       ===================================================================== -->
  <section class="section" aria-label="Known data limitations">
    <div class="container">
      <h2>Known data limitations</h2>
      <hr class="accent-rule" />
      <p>{limitations_body}</p>
    </div>
  </section>

</BaseLayout>

<style>
  .hero .btn { margin-right: var(--space-xs); margin-top: var(--space-xs); }

  /* Explainer teaser. A white card on the alt ground, so it reads as a way out
     of the page rather than another paragraph of it. */
  .peek {
    background: var(--color-white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: var(--space-sm);
  }
  .peek__fig { margin: 0 0 var(--space-sm); }
  .peek__fig svg { display: block; width: 100%; height: auto; }
  .peek h3 { margin-bottom: var(--space-xs); }
  .peek p { margin-bottom: var(--space-sm); }

  .pk-box  { fill: none; stroke: var(--color-dark); stroke-width: 1.5; }
  .pk-line { stroke: var(--color-dark); stroke-width: 1.5; }
  .pk-dash { stroke: var(--color-text-muted); stroke-width: 1.25; stroke-dasharray: 4 4; fill: none; }
  .pk-head { fill: var(--color-dark); }
  .pk-pin  { fill: var(--color-init-earth); }
  .pk-gone { fill: none; stroke: var(--color-text-muted); stroke-width: 1.5; }
  .pk-cap  { font-family: var(--font-body); font-size: 11px; font-weight: 700; letter-spacing: 1px; fill: var(--color-text-muted); }
  .pk-s    { font-family: var(--font-body); font-size: 11px; fill: var(--color-text-muted); text-anchor: middle; }
  .pk-e    { font-family: var(--font-body); font-size: 11px; fill: var(--color-text-muted); }
  .app-embed {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    background: #111;
  }
  .app-embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  @media (max-width: 600px) {
    .app-embed { aspect-ratio: 3 / 4; }
  }
</style>
