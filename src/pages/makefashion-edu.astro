---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { marked } from 'marked';

const entry = await getEntry('pages', 'makefashion-edu');
const {
  hero_title, hero_tagline, engineering_text, heritage_text, runway_text,
  classes_text, getintouch_text, instagram_url, instagram_photos,
} = entry.data;

/* Layout mirrors the original makefashion.ca/edu landing page (section
   order and structure), expressed in this site's design system with the
   darker treatment — the WordPress original stays light; ours is dark. */

const md = (s: string) => marked.parse(s ?? '');

const engineeringGrid = [
  { src: "/images/mfedu/1206673384-1-scaled.jpg", alt: "Students collaborating on a fashion tech piece" },
  { src: "/images/mfedu/IMG_8816.jpg",            alt: "Student work in progress" },
  { src: "/images/mfedu/IMG_1041.jpg",            alt: "MakeFashion Edu student at work" },
  { src: "/images/mfedu/Shaw-1170582.jpg",        alt: "MakeFashion Edu runway showcase" },
];
---

<BaseLayout
  title="MakeFashion Edu"
  description="FashionTech in every classroom. Students combine fashion and technology in pieces they design from the ground up — MakeFashion Edu's programs, courses, and runway events are run by SteamHead."
>

  <!-- =====================================================================
       HERO — the iconic scattered-photo top from makefashion.ca/edu,
       recreated on the site's dark treatment. Ghost "MFEDU", right-aligned
       title block, five staggered photos.
       ===================================================================== -->
  <section class="mfedu-hero" aria-label="MakeFashion Edu">
    <div class="container mfedu-hero__grid">
      <span class="mfedu-hero__ghost" aria-hidden="true">MFEDU</span>

      <div class="mfedu-hero__text">
        <h1>{hero_title}</h1>
        <p>{hero_tagline}</p>
        <a href="/shelf/" class="btn btn--primary mt-md">Take the Online Course</a>
      </div>

      <img class="ph ph--a" src="/images/mfedu/20180527_181848639_iOS.jpg"
        alt="Student in an illuminated dress walking the MakeFashion Edu runway" />
      <img class="ph ph--b" src="/images/mfedu/1080-2622-1.jpg"
        alt="Student designer wearing a lighted hoop piece" loading="lazy" />
      <img class="ph ph--c" src="/images/mfedu/WeChat-Image_20181205214747.jpg"
        alt="Two students in glowing fashion tech pieces" loading="lazy" />
      <img class="ph ph--d" src="/images/mfedu/7V4A8258.jpg"
        alt="Young designer in a handmade outfit with props" loading="lazy" />
      <img class="ph ph--e" src="/images/mfedu/Shaw-lr-1016638.jpg"
        alt="Student wearing an LED wearable creation" loading="lazy" />
    </div>
  </section>

  <!-- MFEdu section navigation strip -->
  <nav class="mfedu-strip" aria-label="MakeFashion Edu sections">
    <div class="container mfedu-strip__inner">
      <a href="/makefashion-edu/runwayshows/">Runway Shows</a>
      <a href="/makefashion-edu/mfedu-program-benefits/">Run the Program</a>
      <a href="/makefashion-edu/partners/">Our Partners</a>
      <a href="/makefashion-edu/resources/">Resources</a>
      <a href="/shelf/">Online Course</a>
    </div>
  </nav>

  <!-- =====================================================================
       ENGINEERING + FASHION
       ===================================================================== -->
  <section class="section section--dark" aria-label="Engineering and Fashion">
    <div class="container">
      <div class="two-col">
        <div>
          <h2>Engineering + Fashion</h2>
          <hr class="accent-rule" />
          <div set:html={md(engineering_text)} />
        </div>
        <div class="photo-grid">
          {engineeringGrid.map(img => (
            <img src={img.src} alt={img.alt} loading="lazy" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       HERITAGE — the origin story
       Same wording as reference/makefashion-ca-edu-heritage-copy.md; the
       two pages must tell the same story in the same words.
       DRAFT: origin story needs Ben's review/expansion
       ===================================================================== -->
  <section class="section" aria-label="Our story">
    <div class="container">
      <h2>Born in Shenzhen</h2>
      <hr class="accent-rule" />
      <div class="heritage-body mt-md" set:html={md(heritage_text)} />
    </div>
  </section>

  <!-- =====================================================================
       THE RUNWAY
       ===================================================================== -->
  <section class="section section--dark" aria-label="The Runway">
    <div class="container">
      <div class="two-col two-col--reverse">
        <img
          src="/images/2024/02/shenzhen2019_02.jpg"
          alt="MakeFashion Edu runway show in Shenzhen 2019"
        />
        <div>
          <h2>The Runway</h2>
          <hr class="accent-rule" />
          <p>{runway_text}</p>
          <p>
            Every season's show is captured in a full gallery publication —
            find them all on The Shelf.
          </p>
          <a href="/shelf/" class="btn btn--outline mt-md">See the Season Books</a>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       THE CLASSES
       ===================================================================== -->
  <section class="section" aria-label="The Classes">
    <div class="container">
      <div class="two-col">
        <div>
          <h2>The Classes</h2>
          <hr class="accent-rule" />
          <p>{classes_text}</p>
          <p>
            Ready-to-teach course guides — including the full-semester guide and
            Simple Circuits activities — are free on The Shelf.
          </p>
          <a href="/shelf/" class="btn btn--outline mt-md">Get the Course Guides</a>
        </div>
        <div class="img-pair">
          <img
            src="/images/2024/01/mfedu_landing02.jpg"
            alt="MakeFashion Edu classroom activity"
          />
          <img
            src="/images/2024/01/mfedu_landing03.jpg"
            alt="Students presenting their MakeFashion projects"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       ONLINE COURSE — primary CTA
       TODO: repoint at the course landing page when the course-sequence
       build lands (route does not exist yet; /shelf/ is where the course
       lives today).
       ===================================================================== -->
  <section class="section section--dark cta-band" aria-label="Online course">
    <div class="container">
      <h2>Bring FashionTech to Your Classroom</h2>
      <hr class="accent-rule" />
      <p class="mt-md">
        The MakeFashion Edu Online Course walks educators and students through
        the whole journey — design thinking, electronics, and fashion tech —
        at your own pace, no experience required.
      </p>
      <a href="/shelf/" class="btn btn--primary mt-md">Start the Online Course</a>
    </div>
  </section>

  <!-- =====================================================================
       MFEDU SOCIAL — curated grid, CMS-editable
       ===================================================================== -->
  <section class="section" aria-label="MFEdu social">
    <div class="container">
      <h2>MFEdu Social</h2>
      <hr class="accent-rule" />
      <div class="insta-grid mt-md">
        {(instagram_photos ?? []).map((photo: { image: string; alt?: string }) => (
          <a href={instagram_url} target="_blank" rel="noopener" class="insta-item">
            <img src={photo.image} alt={photo.alt ?? "MakeFashion Edu on Instagram"} loading="lazy" />
          </a>
        ))}
      </div>
      <a
        href={instagram_url}
        class="btn btn--primary mt-md"
        target="_blank"
        rel="noopener"
      >
        @makefashionedu on Instagram
      </a>
    </div>
  </section>

  <!-- =====================================================================
       GET IN TOUCH
       ===================================================================== -->
  <section class="section section--dark" aria-label="Get in touch">
    <div class="container">
      <h2>Get In Touch</h2>
      <hr class="accent-rule" />
      <div class="mt-md" set:html={md(getintouch_text)} />
      <div class="cta-row">
        <a href="https://www.facebook.com/groups/steamhead.space" class="btn btn--primary" target="_blank" rel="noopener">
          Join the Facebook Group
        </a>
        <a href="/contact-us/" class="btn btn--outline">Contact Us</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ------- Iconic scattered hero ------- */
  .mfedu-hero {
    background: var(--color-black);
    color: var(--color-white);
    overflow: hidden;
    padding-block: var(--space-lg) var(--space-xl);
  }
  .mfedu-hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 5fr 4fr 2.5fr 2fr;
    grid-template-rows: auto auto auto;
    gap: var(--space-md);
    align-items: start;
  }
  .mfedu-hero__ghost {
    position: absolute;
    top: -1.5rem;
    left: 34%;
    font-family: var(--font-heading);
    font-size: clamp(4rem, 10vw, 8.5rem);
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.08);
    pointer-events: none;
    line-height: 1;
    z-index: 0;
  }
  .mfedu-hero__text {
    grid-column: 1;
    grid-row: 1 / 3;
    text-align: right;
    align-self: center;
    z-index: 1;
    margin-top: var(--space-lg);
  }
  .mfedu-hero__text h1 {
    color: var(--color-yellow);
    line-height: 1.05;
  }
  .mfedu-hero__text p {
    margin-top: var(--space-sm);
    color: #ccc;
    font-size: var(--text-sm);
    max-width: 34ch;
    margin-left: auto;
  }
  .mfedu-hero .ph {
    width: 100%;
    object-fit: cover;
    border-radius: 2px;
    z-index: 1;
  }
  .ph--a { grid-column: 2; grid-row: 1 / 3; aspect-ratio: 3 / 4; margin-top: 3.5rem; }
  .ph--b { grid-column: 3 / 5; grid-row: 1; aspect-ratio: 4 / 3; margin-top: 1rem; }
  .ph--c { grid-column: 3 / 5; grid-row: 2; aspect-ratio: 21 / 9; }
  .ph--d { grid-column: 2; grid-row: 3; aspect-ratio: 3 / 4; width: 78%; justify-self: center; margin-top: -1rem; }
  .ph--e { grid-column: 3 / 5; grid-row: 3; aspect-ratio: 4 / 5; width: 85%; }

  @media (max-width: 820px) {
    .mfedu-hero__grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: none;
    }
    .mfedu-hero__ghost { position: static; grid-column: 1 / 3; text-align: center; }
    .mfedu-hero__text {
      grid-column: 1 / 3; grid-row: auto;
      text-align: center; margin-top: 0;
    }
    .mfedu-hero__text p { margin-inline: auto; }
    .ph--a, .ph--b, .ph--c, .ph--d, .ph--e {
      grid-column: auto; grid-row: auto;
      margin: 0; width: 100%; aspect-ratio: 3 / 4; justify-self: stretch;
    }
    .ph--c { grid-column: 1 / 3; aspect-ratio: 21 / 9; }
  }

  /* ------- Section strip nav ------- */
  .mfedu-strip {
    background: #111;
    border-block: 1px solid #222;
  }
  .mfedu-strip__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding-block: 0.7rem;
  }
  .mfedu-strip a {
    color: #ccc;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .mfedu-strip a:hover { color: var(--color-yellow); opacity: 1; }

  .photo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }
  .photo-grid img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .heritage-body { max-width: 70ch; }

  .img-pair {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .cta-band { text-align: left; }

  .cta-row {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-md);
  }

  .insta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-sm);
  }
  .insta-item img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    display: block;
    transition: opacity 0.15s;
  }
  .insta-item:hover img { opacity: 0.85; }
</style>
