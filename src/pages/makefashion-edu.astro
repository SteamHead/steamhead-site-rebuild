---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, getCollection } from 'astro:content';
import { marked } from 'marked';

const entry = await getEntry('pages', 'makefashion-edu');
const {
  hero_title, hero_tagline, engineering_text, heritage_text, runway_text,
  classes_text, getintouch_text, publishing,
} = entry.data;

/* Layout mirrors the original makefashion.ca/edu landing page (section
   order and structure), expressed in this site's design system. Dark
   treatment is limited to the hero + section strip; the rest alternates
   white and grey. */

const md = (s: string) => marked.parse(s ?? '');

/* Student pieces shot on black — shows the "engineering + fashion" result
   rather than repeating the classroom photos used in The Classes below. */
const engineeringGrid = [
  { src: "/images/mfedu/2022/06/proj_changeyouraltitude01-scaled.jpg", alt: "Student in red plaid outfit with warm LED lights and illuminated backpack" },
  { src: "/images/mfedu/2022/06/proj_octo01-scaled.jpg",               alt: "Student wearing octopus costume with glowing blue and pink LED tentacles" },
  { src: "/images/mfedu/2022/06/proj_moodmusic04-scaled.jpg",          alt: "Student holding illuminated guitar with star and moon design and glowing edge lights" },
  { src: "/images/mfedu/2022/06/proj_keepearthbeautiful09-scaled.jpg", alt: "Student in dress with large green skirt decorated with glowing multicolor LED hem" },
];

/* Runway seasons, grouped by city, straight from the mfedu collection so
   the list can't drift from the season pages that actually exist. Titles
   are "<City> <Year>[ S<n>]". */
const seasons = (await getCollection('mfedu'))
  .filter(p => p.data.section === 'runway-shows' && /\d{4}/.test(p.data.title))
  .map(p => ({
    city:  p.data.title.replace(/\s+\d{4}.*$/, ''),
    label: p.data.title.replace(/^.*?(\d{4})(.*)$/, '$1$2').trim(),
    year:  Number(p.data.title.match(/\d{4}/)![0]),
    href:  `/makefashion-edu/${p.id}/`,
  }))
  .sort((a, b) => a.year - b.year || a.label.localeCompare(b.label));
const cities = [...new Set(seasons.map(s => s.city))]
  .map(city => ({ city, shows: seasons.filter(s => s.city === city) }))
  .sort((a, b) => a.shows[0].year - b.shows[0].year);
const firstYear = seasons[0]?.year;

const directory = [
  { title: "Runway Shows",    href: "/makefashion-edu/runwayshows/",             text: "Every season's STEAM runway, from Shenzhen to Tucson." },
  { title: "Run the Program", href: "/makefashion-edu/mfedu-program-benefits/",  text: "Step-by-step guide to hosting MakeFashion Edu yourself." },
  { title: "Our Partners",    href: "/makefashion-edu/partners/",                text: "The schools, companies, and communities behind the program." },
  { title: "Resources",       href: "/makefashion-edu/resources/",               text: "Videos, calendars, and printables for your classroom." },
  { title: "Online Course",   href: "/courses/mfedu-intro/",                     text: "Learn at your own pace — no experience required.", primary: true },
];
---

<BaseLayout
  title="MakeFashion Edu"
  description="FashionTech in every classroom. Students combine fashion and technology in pieces they design from the ground up — MakeFashion Edu's programs, courses, and runway events are run by SteamHead."
>

  <!-- =====================================================================
       HERO — title + tagline side by side, then an aligned photo mosaic
       (two tall portraits, a wide runway shot, two crops). Echoes the
       photo-heavy top of makefashion.ca/edu without the scattered offsets.
       ===================================================================== -->
  <section class="mfedu-hero" aria-label="MakeFashion Edu">
    <div class="container">
      <div class="mfedu-hero__text">
        <h1>{hero_title}</h1>
        <p>{hero_tagline}</p>
      </div>

      <div class="mfedu-hero__mosaic">
        <img class="ph ph--a" src="/images/mfedu/20180527_181848639_iOS.jpg"
          alt="Student in an illuminated dress walking the MakeFashion Edu runway" />
        <img class="ph ph--b" src="/images/mfedu/1080-2622-1.jpg"
          alt="Student designer wearing a lighted hoop piece" />
        <img class="ph ph--c" src="/images/mfedu/WeChat-Image_20181205214747.jpg"
          alt="Two students in glowing fashion tech pieces" />
        <img class="ph ph--d" src="/images/mfedu/7V4A8258.jpg"
          alt="Young designer in a handmade outfit with props" loading="lazy" />
        <img class="ph ph--e" src="/images/mfedu/Shaw-lr-1016638.jpg"
          alt="Student wearing an LED wearable creation" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- MFEdu section directory — cards directly under the hero so the
       subsections can't be missed. The Online Course card is highlighted
       as the primary entry point. -->
  <nav class="mfedu-dir" aria-labelledby="mfedu-dir-heading">
    <div class="container">
      <h2 id="mfedu-dir-heading" class="mfedu-dir__heading">Explore MakeFashion Edu</h2>
      <ul class="mfedu-dir__grid" role="list">
        {directory.map(item => (
          <li>
            <a href={item.href} class:list={["mfedu-dir__card", { "mfedu-dir__card--primary": item.primary }]}>
              <span class="mfedu-dir__title">{item.title}</span>
              <span class="mfedu-dir__text">{item.text}</span>
              <span class="mfedu-dir__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- =====================================================================
       ENGINEERING + FASHION
       ===================================================================== -->
  <section class="section" aria-labelledby="mfedu-eng-heading">
    <div class="container">
      <div class="two-col">
        <div>
          <h2 id="mfedu-eng-heading">Engineering + Fashion</h2>
          <hr class="accent-rule" />
          <div class="prose-lead" set:html={md(engineering_text)} />
        </div>
        <figure class="showcase">
          <div class="showcase__grid">
            {engineeringGrid.map(img => (
              <img src={img.src} alt={img.alt} loading="lazy" />
            ))}
          </div>
          <figcaption>
            Student pieces from the Tucson runways.
            <a href="/makefashion-edu/runwayshows/">See every show →</a>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       HERITAGE — the origin story
       Same wording as reference/makefashion-ca-edu-heritage-copy.md; the
       two pages must tell the same story in the same words. The aside only
       restates facts already in that text — don't add new claims there.
       DRAFT: origin story needs Ben's review/expansion
       ===================================================================== -->
  <section class="section section--alt" aria-labelledby="mfedu-heritage-heading">
    <div class="container">
      <h2 id="mfedu-heritage-heading">Born in Shenzhen</h2>
      <hr class="accent-rule" />
      <div class="heritage mt-md">
        <div class="heritage__body" set:html={md(heritage_text)} />
        <aside class="heritage__aside" aria-label="Key moments">
          <ol class="timeline" role="list">
            <li>
              <span class="timeline__when">2015</span>
              <span class="timeline__what">Carrie Leung and James Simpson see the MakeFashion runway at the Shenzhen Maker Faire.</span>
            </li>
            <li>
              <span class="timeline__when">Next</span>
              <span class="timeline__what">Shannon and Maria Hoover advise Carrie on building the program around the runway.</span>
            </li>
            <li>
              <span class="timeline__when">Today</span>
              <span class="timeline__what">MakeFashion Edu's programs, courses, and runway events are run by SteamHead.</span>
            </li>
          </ol>
          <a href="https://makefashion.ca" class="heritage__link" target="_blank" rel="noopener">
            Visit MakeFashion <span aria-hidden="true">↗</span>
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       THE RUNWAY
       ===================================================================== -->
  <section class="section" aria-labelledby="mfedu-runway-heading">
    <div class="container">
      <div class="two-col two-col--reverse">
        <img
          class="runway-photo"
          src="/images/2024/02/shenzhen2019_02.jpg"
          alt="Student's light-up solar-system hoop skirt on the Shenzhen 2019 runway"
          loading="lazy"
        />
        <div>
          <h2 id="mfedu-runway-heading">The Runway</h2>
          <hr class="accent-rule" />
          <p>{runway_text}</p>
          {seasons.length > 0 && (
            <p class="runway-stats">
              <strong>{seasons.length}</strong> runway shows ·{' '}
              <strong>{cities.length}</strong> cities · since <strong>{firstYear}</strong>
            </p>
          )}
          <ul class="runway-cities" role="list">
            {cities.map(c => (
              <li>
                <span class="runway-cities__city">{c.city}</span>
                <span class="runway-cities__years">
                  {c.shows.map(show => (
                    <a href={show.href} aria-label={`${c.city} ${show.label}`}>{show.label}</a>
                  ))}
                </span>
              </li>
            ))}
          </ul>
          <div class="cta-row">
            <a href="/makefashion-edu/runwayshows/" class="btn btn--outline">Browse the Runway Shows</a>
            <a href="/theshelf/" class="text-link">Season books on The Shelf →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       THE CLASSES
       ===================================================================== -->
  <section class="section section--alt" aria-labelledby="mfedu-classes-heading">
    <div class="container">
      <div class="two-col">
        <div>
          <h2 id="mfedu-classes-heading">The Classes</h2>
          <hr class="accent-rule" />
          <p>{classes_text}</p>
          <p>
            Ready-to-teach course guides — including the full-semester guide and
            Simple Circuits activities — are free on The Shelf.
          </p>
          <div class="cta-row">
            <a href="/theshelf/" class="btn btn--outline">Get the Course Guides</a>
            <a href="/makefashion-edu/mfedu-program-benefits/" class="text-link">How to run the program →</a>
          </div>
        </div>
        <div class="class-photos">
          <img
            class="class-photos__main"
            src="/images/2024/01/mfedu_landing02.jpg"
            alt="Teacher helping a student fit a folded-paper dragon headpiece"
            loading="lazy"
          />
          <img
            src="/images/2024/01/mfedu_landing03.jpg"
            alt="Student wiring a circuit onto a cardboard cutout"
            loading="lazy"
          />
          <img
            src="/images/mfedu/IMG_8823.jpg"
            alt="Two students working together at a classroom table"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       ONLINE COURSES — primary CTA. Mirrors The Shelf: the 2026 edition is
       the recommended start, the 2022 original stays available.
       ===================================================================== -->
  <section class="section" aria-labelledby="mfedu-course-heading">
    <div class="container">
      <div class="course-panel">
        <p class="kicker">Free · Self-paced · No experience required</p>
        <h2 id="mfedu-course-heading">Bring FashionTech to Your Classroom</h2>
        <hr class="accent-rule" />
        <p>
          The MakeFashion Edu Online Course walks educators and students through
          the whole journey — design thinking, electronics, and fashion tech —
          at your own pace, no experience required.
        </p>
        <img
          class="course-panel__arc"
          src="/images/courses/mfedu-2026/project-arc.svg"
          alt="The course arc: Find Your Story, Research It, Design It, Light It Up, Build It, Show It"
          loading="lazy"
        />
        <ul class="course-options" role="list">
          <li class="course-option course-option--primary">
            <span class="course-option__tag">2026 edition</span>
            <h3>Advocacy by Design</h3>
            <p>One project, start to finish: find a cause, fact-check it, design for it, wire it with light — and walk it down a runway.</p>
            <a href="/courses/mfedu-2026/" class="btn btn--primary">Start the 2026 Course</a>
          </li>
          <li class="course-option">
            <span class="course-option__tag">2022 original</span>
            <h3>Introduction Course</h3>
            <p>The original course: lights, circuits, and recycled materials used to tell advocacy stories, with printable worksheets.</p>
            <a href="/courses/mfedu-intro/" class="btn btn--outline">Open the Original Course</a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       COMMUNITY — get in touch + where MakeFashion Edu publishes
       ===================================================================== -->
  <section class="section section--alt" aria-labelledby="mfedu-touch-heading">
    <div class="container">
      <div class="two-col community">
        <div>
          <h2 id="mfedu-touch-heading">Get In Touch</h2>
          <hr class="accent-rule" />
          <div class="mt-md" set:html={md(getintouch_text)} />
          <div class="cta-row">
            <a href="https://www.facebook.com/groups/steamhead.space" class="btn btn--primary" target="_blank" rel="noopener">
              Join the Facebook Group
            </a>
            <a href="/contact-us/" class="btn btn--outline">Contact Us</a>
          </div>
        </div>
        <div>
          <h3 class="community__heading">Follow MakeFashion Edu</h3>
          <ul class="pub-list" role="list">
            {(publishing ?? []).map((item: { name: string; url: string; image: string }) => (
              <li>
                <a href={item.url} target="_blank" rel="noopener" class="pub-card">
                  <img src={item.image} alt="" loading="lazy" />
                  <span class="pub-card__name">{item.name}</span>
                  <span class="pub-card__arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ------- Hero: text row + photo mosaic ------- */
  .mfedu-hero {
    background: var(--color-black);
    color: var(--color-white);
    padding-block: var(--space-lg);
  }
  .mfedu-hero__text {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    align-items: end;
    margin-bottom: var(--space-md);
  }
  .mfedu-hero__text h1 {
    color: var(--color-yellow);
    line-height: 1.05;
    margin: 0;
  }
  .mfedu-hero__text p {
    margin: 0;
    color: var(--color-gray-mid);
    max-width: 52ch;
  }

  .mfedu-hero__mosaic {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, clamp(150px, 18vw, 240px));
    grid-template-areas:
      "a b c c"
      "a b d e";
    gap: var(--space-sm);
  }
  .mfedu-hero .ph {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ph--a { grid-area: a; }
  .ph--b { grid-area: b; object-position: center 20%; }
  .ph--c { grid-area: c; }
  .ph--d { grid-area: d; object-position: center 25%; }
  .ph--e { grid-area: e; object-position: center 15%; }

  @media (max-width: 820px) {
    .mfedu-hero__text { grid-template-columns: 1fr; gap: var(--space-sm); }
    .mfedu-hero__text h1 { font-size: var(--text-4xl); }
    .mfedu-hero__mosaic {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: repeat(2, 56vw) 30vw 40vw;
      grid-template-areas:
        "a b"
        "a b"
        "c c"
        "d e";
    }
  }
  @media (max-width: 480px) {
    .mfedu-hero__text h1 { font-size: var(--text-3xl); }
    .mfedu-hero__mosaic { grid-template-rows: 44vw 44vw 34vw 44vw; }
  }

  /* ------- Section directory cards ------- */
  .mfedu-dir {
    background: var(--color-dark-surface);
    border-block: 1px solid var(--color-dark-border);
    padding-block: var(--space-md) var(--space-lg);
  }
  .mfedu-dir__heading {
    color: var(--color-white);
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
  }
  .mfedu-dir__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-sm);
  }
  .mfedu-dir__card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm);
    background: var(--color-dark-raised);
    border: 1px solid var(--color-dark-border);
    border-top: 4px solid var(--color-init-mfedu);
    border-radius: var(--radius);
    color: var(--color-white);
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
  }
  .mfedu-dir__card:hover,
  .mfedu-dir__card:focus-visible {
    transform: translateY(-3px);
    box-shadow: var(--shadow-pop);
    border-color: var(--color-init-mfedu);
    opacity: 1;
  }
  .mfedu-dir__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-white);
  }
  .mfedu-dir__text {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--color-text-dim);
  }
  .mfedu-dir__arrow {
    font-size: var(--text-xl);
    color: var(--color-init-mfedu);
    transition: transform 0.15s;
  }
  .mfedu-dir__card:hover .mfedu-dir__arrow { transform: translateX(4px); }

  .mfedu-dir__card--primary {
    background: var(--color-cta-bg);
    border-color: var(--color-cta-bg);
  }
  .mfedu-dir__card--primary:hover,
  .mfedu-dir__card--primary:focus-visible { border-color: var(--color-yellow); }
  .mfedu-dir__card--primary .mfedu-dir__title,
  .mfedu-dir__card--primary .mfedu-dir__text,
  .mfedu-dir__card--primary .mfedu-dir__arrow { color: var(--color-cta-text); }

  @media (max-width: 1000px) {
    .mfedu-dir__grid { grid-template-columns: repeat(2, 1fr); }
    .mfedu-dir__grid > li:last-child { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .mfedu-dir__text { display: none; }
    .mfedu-dir__title { font-size: var(--text-base); }
  }

  /* ------- Shared bits ------- */
  .cta-row {
    display: flex;
    gap: var(--space-sm) var(--space-md);
    flex-wrap: wrap;
    align-items: center;
    margin-top: var(--space-md);
  }
  .text-link { white-space: nowrap; }
  .kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  /* ------- Engineering + Fashion ------- */
  .showcase { margin: 0; }
  .showcase__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xs);
    background: var(--color-black);
    padding: var(--space-xs);
    border-radius: var(--radius);
  }
  .showcase__grid img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
  }
  .showcase figcaption {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  @media (min-width: 821px) {
    .showcase__grid { grid-template-columns: 1fr 1fr; }
    .showcase__grid img { aspect-ratio: 1 / 1; object-position: center 20%; }
  }

  /* ------- Heritage ------- */
  .heritage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--space-lg);
    align-items: start;
  }
  .heritage__body :global(p) { max-width: 66ch; }
  .heritage__aside {
    position: sticky;
    top: var(--space-md);
    background: var(--color-white);
    border-top: 4px solid var(--color-init-mfedu);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: var(--space-md);
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .timeline li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    position: relative;
    padding: 0 0 var(--space-sm) var(--space-sm);
    margin: 0;
    border-left: 2px solid var(--color-border);
  }
  .timeline li:last-child { padding-bottom: 0; border-left-color: transparent; }
  .timeline li::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 0.3rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-yellow);
  }
  .timeline__when {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-heading);
    line-height: 1.2;
  }
  .timeline__what { font-size: var(--text-sm); }
  .heritage__link {
    display: inline-block;
    margin-top: var(--space-md);
    font-size: var(--text-sm);
  }
  @media (max-width: 900px) {
    .heritage { grid-template-columns: 1fr; gap: var(--space-md); }
    .heritage__aside { position: static; }
  }

  /* ------- Runway ------- */
  .runway-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .runway-stats {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .runway-stats strong {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    letter-spacing: 0;
    color: var(--color-heading);
  }
  .runway-cities {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  .runway-cities li {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-xs);
    align-items: baseline;
    padding-block: 0.45rem;
    margin: 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }
  .runway-cities__city {
    font-weight: 700;
    color: var(--color-heading);
  }
  .runway-cities__years {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
  }
  @media (max-width: 480px) {
    .runway-cities li { grid-template-columns: 1fr; gap: 0.15rem; }
  }

  /* ------- Classes: one wide photo over two ------- */
  .class-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }
  .class-photos img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .class-photos__main {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9 !important;
  }

  /* ------- Online courses ------- */
  .course-panel {
    border: 1px solid var(--color-border);
    border-top: 6px solid var(--color-yellow);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: var(--space-lg) var(--space-md);
  }
  .course-panel__arc {
    width: 100%;
    max-width: 760px;
    margin: var(--space-md) auto;
    border-radius: 0;
  }
  .course-options {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }
  .course-option {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin: 0;
    padding: var(--space-md);
    background: var(--color-gray-light);
