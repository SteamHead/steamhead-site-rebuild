---
import BaseLayout from '../layouts/BaseLayout.astro';

const books = [
  { title: "MFEdu SF 2025 BSU",       slug: "mfedu-sf-2025-bsu" },
  { title: "MFEDU Tucson 2025",        slug: "mfedu-tucson-2025" },
  { title: "MFEDU Tucson 2024",        slug: "mfedu-tucson-2024" },
  { title: "MFEDU Tucson 2023",        slug: "mfedu-tucson-2023" },
];

const hardware = [
  {
    name: "bit:controller (with USB power adapter)",
    description: "WS2812B / SK6812 addressable LED controller",
    url: "https://www.amazon.com/Controller-WS2812B-SK6812-addressable-Pixels/dp/B0BV1RWSKN/",
  },
  {
    name: "The Line:Bit — 1 metre WS2812B LEDs",
    description: "Individually addressable, programmable LED strip",
    url: "https://www.amazon.com/SEZO-Individually-Addressable-Programmable-Non-Waterproof/dp/B097BX7LRT",
  },
];
---

<BaseLayout
  title="Shop"
  description="SteamHead resources, courses, and tools for educators and makers — teacher-tested and community-built."
>

  <!-- =====================================================================
       HERO
       ===================================================================== -->
  <section class="hero hero--short" aria-label="The Shelf">
    <img
      class="hero__bg"
      src="/images/2024/01/hr-nologo-1015396-scaled.jpg"
      alt="SteamHead resources and tools"
    />
    <div class="container hero__content">
      <h1>The Shelf</h1>
      <p class="hero__tagline">
        Everything you see here is fun AND teacher-tested. We want to share the goodness
        and we want you to be able to make the projects on your own.
      </p>
    </div>
  </section>

  <!-- =====================================================================
       SHTEAM LABS
       ===================================================================== -->
  <section class="section" aria-label="SHTEAM Labs activity journals">
    <div class="container">
      <div class="two-col">
        <div>
          <h2>SHTEAM Labs</h2>
          <hr class="accent-rule" />
          <p>
            SteamHead Team Labs collaborates with teachers creating activities
            tailored to their communities. We're sharing the content in case the
            combinations are a good fit for your community as well.
          </p>

          <div class="product-card mt-md">
            <h3>SHTEAM Labs 1</h3>
            <p class="product-subtitle">Cardboard Engineering + Simple Electronics</p>
            <p>
              An introductory activity journal combining low-tech and electronic
              prototyping — perfect for hands-on STEAM classrooms.
            </p>
            <a
              href="https://www.steamhead.space/shop/"
              class="btn btn--primary"
              target="_blank"
              rel="noopener"
            >
              Get It
            </a>
          </div>
        </div>
        <img
          src="/images/2021/08/GettingStartedWithMFEDU.png"
          alt="SHTEAM Labs activity journal"
        />
      </div>
    </div>
  </section>

  <!-- =====================================================================
       ONLINE COURSE
       ===================================================================== -->
  <section class="section section--alt" aria-label="MakeFashion Edu online course">
    <div class="container">
      <div class="two-col two-col--reverse">
        <img
          src="/images/2023/09/1.png"
          alt="MakeFashion Edu online course"
        />
        <div>
          <h2>MakeFashion Edu Online Course</h2>
          <hr class="accent-rule" />
          <p>
            The MakeFashion Edu Online Course integrates technology and creativity into
            classrooms across the globe.
          </p>
          <p>
            With engaging modules, students explore design thinking, electronics, and
            fashion tech — turning their ideas into wearable creations. More than just
            fashion, this course equips students with the skills to express themselves
            and boost their confidence through innovation.
          </p>
          <a
            href="https://www.steamhead.space/shop/"
            class="btn btn--primary mt-md"
            target="_blank"
            rel="noopener"
          >
            Enrol Now
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       HARDWARE LINKS
       ===================================================================== -->
  <section class="section" aria-label="Recommended hardware">
    <div class="container">
      <h2>Lights &amp; Controllers</h2>
      <hr class="accent-rule" />
      <p class="mt-md">
        Here are links to the introductory hardware we commonly use. Any vendor selling
        hardware with the same model numbers and adaptors will work — feel free to
        contact us if you need a fresh recommendation.
      </p>

      <div class="hardware-list mt-md">
        {hardware.map(item => (
          <div class="hardware-item">
            <div>
              <h3>{item.name}</h3>
              <p class="text-muted">{item.description}</p>
            </div>
            <a href={item.url} class="btn btn--outline" target="_blank" rel="noopener">
              View on Amazon
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       BOOKS
       ===================================================================== -->
  <section class="section section--dark" aria-label="MakeFashion Edu publications">
    <div class="container">
      <h2>MakeFashion Edu Books</h2>
      <hr class="accent-rule" />
      <p class="mt-md">
        Each season's runway show is captured in a full publication — gallery photos,
        materials lists, and the stories behind every project.
      </p>

      <div class="book-grid mt-md">
        {books.map(book => (
          <div class="book-card">
            <span class="book-icon" aria-hidden="true">📖</span>
            <h3>{book.title}</h3>
            <a
              href={`https://www.steamhead.space/shop/`}
              class="btn btn--outline"
              target="_blank"
              rel="noopener"
            >
              View
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       CONTACT CTA
       ===================================================================== -->
  <section class="section section--alt" aria-label="Contact">
    <div class="container">
      <h2>Want Something Specific?</h2>
      <hr class="accent-rule" />
      <p class="mt-md">
        Let us know if you'd like to see anything specific here — we're always adding
        new resources and love hearing from teachers about what would be most useful.
      </p>
      <a
        href="https://www.steamhead.space/contact-us/"
        class="btn btn--primary mt-md"
        target="_blank"
        rel="noopener"
      >
        Contact Us
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  .hero--short { padding-block: var(--space-lg); }

  .product-card {
    background: var(--color-gray-light);
    border-left: 4px solid var(--color-yellow);
    padding: var(--space-md);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .product-card h3 { color: var(--color-dark); font-family: var(--font-heading); }
  .product-subtitle { font-weight: 600; color: var(--color-dark); margin: 0; font-size: var(--text-sm); }

  .hardware-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .hardware-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--color-gray-light);
    border-radius: var(--radius);
  }
  .hardware-item h3 { font-family: var(--font-body); font-size: var(--text-base); font-weight: 600; color: var(--color-dark); }
  @media (max-width: 600px) {
    .hardware-item { flex-direction: column; align-items: flex-start; }
  }

  .book-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-md);
  }
  .book-card {
    background: #111;
    border: 1px solid #333;
    border-radius: var(--radius);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    align-items: flex-start;
  }
  .book-card h3 { font-family: var(--font-body); font-size: var(--text-sm); font-weight: 600; color: var(--color-white); }
  .book-icon { font-size: 1.5rem; }
</style>
