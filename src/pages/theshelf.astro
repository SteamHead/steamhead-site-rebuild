---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'shelf');
const { hero_tagline, shteam_body, course_body, hardware, books } = entry.data;
---

<BaseLayout
  title="The Shelf"
  description="SteamHead resources, courses, and tools for educators and makers — teacher-tested and community-built."
>

  <!-- =====================================================================
       HERO
       ===================================================================== -->
  <section class="hero hero--short" aria-label="The Shelf">
    <img
      class="hero__bg"
      src="/images/2024/01/hr-nologo-1015396-scaled.jpg"
      alt="SteamHead resources and tools"
    />
    <div class="container hero__content">
      <h1>The Shelf</h1>
      <p class="hero__tagline">{hero_tagline}</p>
    </div>
  </section>

  <!-- =====================================================================
       SHTEAM LABS
       ===================================================================== -->
  <section class="section" aria-label="SHTEAM Labs activity journals">
    <div class="container">
      <div class="two-col">
        <div>
          <h2>SHTEAM Labs</h2>
          <hr class="accent-rule" />
          <p>{shteam_body}</p>

          <div class="product-card mt-md">
            <h3>SHTEAM Labs 1</h3>
            <p class="product-subtitle">Cardboard Engineering + Simple Electronics</p>
            <p>
              An introductory activity journal combining low-tech and electronic
              prototyping — perfect for hands-on STEAM classrooms.
            </p>
            <a
              href="https://www.steamhead.space/shop/"
              class="btn btn--primary"
              target="_blank"
              rel="noopener"
            >
              Get It
            </a>
          </div>
        </div>
        <img
          src="/images/2023/09/1.png"
          alt="SHTEAM Labs activity journal"
        />
      </div>
    </div>
  </section>

  <!-- =====================================================================
       ONLINE COURSE
       ===================================================================== -->
  <section class="section section--alt" aria-label="MakeFashion Edu online course">
    <div class="container">
      <div class="two-col two-col--reverse">
        <img
          src="/images/2021/08/GettingStartedWithMFEDU.jpg"
          alt="MakeFashion Edu online course"
        />
        <div>
          <h2>MakeFashion Edu Online Course</h2>
          <hr class="accent-rule" />
          <p>{course_body}</p>
          <a href="/courses/mfedu-intro/" class="btn btn--primary mt-md">
            Start the Course — Free
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       HARDWARE LINKS
       ===================================================================== -->
  <section class="section" aria-label="Recommended hardware">
    <div class="container">
      <h2>Lights &amp; Controllers</h2>
      <hr class="accent-rule" />
      <p class="mt-md">
        Here are links to the introductory hardware we commonly use. Any vendor selling
        hardware with the same model numbers and adaptors will work — feel free to
        contact us if you need a fresh recommendation.
      </p>

      <div class="hardware-list mt-md">
        {hardware.map(item => (
          <div class="hardware-item">
            <div>
              <h3>{item.name}</h3>
              <p class="text-muted">{item.description}</p>
            </div>
            <a href={item.url} class="btn btn--outline" target="_blank" rel="noopener">
              View on Amazon
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       MAKER BADGES
       ===================================================================== -->
  <section class="section section--alt" aria-label="Maker Badges">
    <div class="container">
      <div class="two-col">
        <img
          src="/images/2024/05/badges_sm.png"
          alt="SteamHead Makerspace Badges"
        />
        <div>
          <h2>Maker Badges</h2>
          <hr class="accent-rule" />
          <p>
            The Maker Badges give teachers a pathway to guide students through
            meaningful makerspace experiences. Not "how to 3D print" — but why
            and for who, basing learning on empathy and authentic problem solving.
          </p>
          <a href="/maker-badges/" class="btn btn--primary mt-md">Explore the Badges</a>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       BOOKS
       ===================================================================== -->
  <section class="section section--dark" aria-label="MakeFashion Edu publications">
    <div class="container">
      <h2>MakeFashion Edu Books</h2>
      <hr class="accent-rule" />
      <p class="mt-md">
        Each season's runway show is captured in a full publication — gallery photos,
        materials lists, and the stories behind every project.
      </p>

      <div class="book-carousel mt-md">
        <button class="carousel-btn carousel-btn--prev" aria-label="Previous books">&larr;</button>
        <div class="carousel-track" tabindex="0" aria-label="Book list, scrollable">
          {books.map((book: { title: string; image?: string; url?: string }) => (
            <div class="book-slide">
              {book.image ? (
                <img class="book-cover" src={book.image} alt={`Cover of ${book.title}`} loading="lazy" />
              ) : (
                <div class="book-cover book-cover--placeholder" aria-hidden="true">
                  <span>{book.title}</span>
                </div>
              )}
              <h3>{book.title}</h3>
              <a
                href={book.url ?? "https://www.steamhead.space/shop/"}
                class="btn btn--outline"
                target="_blank"
                rel="noopener"
              >
                View
              </a>
            </div>
          ))}
        </div>
        <button class="carousel-btn carousel-btn--next" aria-label="Next books">&rarr;</button>
      </div>

      <a
        href="https://www.amazon.com/dp/B0B1P4N1YQ"
        class="btn btn--primary mt-md"
        target="_blank"
        rel="noopener"
      >
        View the Whole Collection
      </a>
    </div>
  </section>

  <!-- =====================================================================
       MAKEFASHION EDU COURSE GUIDES
       ===================================================================== -->
  <section class="section" aria-label="MakeFashion Edu Course Guides">
    <div class="container">
      <h2>MakeFashion Edu Course Guides</h2>
      <hr class="accent-rule" />
      <p class="mt-md guide-tagline">Free resources for educators — ready to teach.</p>
      <ul class="guide-list mt-md">
        <li>
          <a href="/guides/mfedu-full-semester-guide/" class="guide-link">
            Full Semester Guide
          </a>
          <span class="guide-desc">Combined teacher &amp; student project guide for the full course</span>
        </li>
        <li>
          <a href="/guides/simple-circuits-shared/" class="guide-link">
            Simple Circuits Activities
          </a>
          <span class="guide-desc">LEDs, paper circuits, and wearable copper tape — one class period
            (<a href="/guides/simple-circuits-teacher/" class="guide-link-teacher">Teacher Guide</a>)
          </span>
        </li>
        <li>
          <a href="#" class="guide-link guide-link--coming">
            Fashion Intro Activities
          </a>
          <span class="guide-desc">Coming soon</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- =====================================================================
       CONTACT CTA
       ===================================================================== -->
  <section class="section section--alt" aria-label="Contact">
    <div class="container">
      <h2>Want Something Specific?</h2>
      <hr class="accent-rule" />
      <p class="mt-md">
        Let us know if you'd like to see anything specific here — we're always adding
        new resources and love hearing from teachers about what would be most useful.
      </p>
      <a href="/contact-us/" class="btn btn--primary mt-md">Contact Us</a>
    </div>
  </section>

</BaseLayout>

<script>
  const track = document.querySelector('.carousel-track');
  const step = () => (track?.querySelector('.book-slide')?.clientWidth ?? 200) + 24;
  document.querySelector('.carousel-btn--prev')?.addEventListener('click', () => {
    track?.scrollBy({ left: -step(), behavior: 'smooth' });
  });
  document.querySelector('.carousel-btn--next')?.addEventListener('click', () => {
    track?.scrollBy({ left: step(), behavior: 'smooth' });
  });
</script>

<style>
  .hero--short { padding-block: var(--space-lg); }

  .product-card {
    background: var(--color-gray-light);
    border-left: 4px solid var(--color-yellow);
    padding: var(--space-md);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .product-card h3 { color: var(--color-dark); font-family: var(--font-heading); }
  .product-subtitle { font-weight: 600; color: var(--color-dark); margin: 0; font-size: var(--text-sm); }

  .hardware-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .hardware-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--color-gray-light);
    border-radius: var(--radius);
  }
  .hardware-item h3 { font-family: var(--font-body); font-size: var(--text-base); font-weight: 600; color: var(--color-dark); }
  @media (max-width: 600px) {
    .hardware-item { flex-direction: column; align-items: flex-start; }
  }

  /* Books carousel — advances on click, never automatically */
  .book-carousel {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .carousel-track {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-block: var(--space-xs);
    scrollbar-width: none;
    flex: 1;
  }
  .carousel-track::-webkit-scrollbar { display: none; }
  .book-slide {
    scroll-snap-align: start;
    flex: 0 0 200px;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    align-items: flex-start;
  }
  .book-cover {
    width: 200px;
    aspect-ratio: 8.5 / 11;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--color-dark-border);
    background: var(--color-dark-surface);
  }
  .book-cover--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-sm);
    background: linear-gradient(160deg, var(--color-dark-raised) 0%, var(--color-dark-surface) 60%);
    border-left: 6px solid var(--color-yellow);
  }
  .book-cover--placeholder span {
    font-family: var(--font-heading);
    color: var(--color-yellow);
    font-size: var(--text-lg);
    line-height: 1.3;
  }
  .book-slide h3 { font-family: var(--font-body); font-size: var(--text-sm); font-weight: 600; color: var(--color-white); }
  .carousel-btn {
    flex-shrink: 0;
    background: var(--color-dark-surface);
    color: var(--color-yellow);
    border: 1px solid var(--color-dark-border);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .carousel-btn:hover { background: var(--color-dark-raised); border-color: var(--color-yellow); }

  .guide-tagline {
    color: var(--color-dark);
    font-size: var(--text-base);
  }
  .guide-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .guide-list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .guide-link {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-teal);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s;
  }
  .guide-link:hover { opacity: 0.75; }
  .guide-link--coming {
    color: var(--color-text-dim);
    cursor: default;
    pointer-events: none;
  }
  .guide-desc {
    font-size: var(--text-sm);
    color: var(--color-text-dim);
  }
  .guide-link-teacher {
    color: var(--color-teal);
    font-size: var(--text-sm);
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
  }
  .guide-link-teacher:hover { opacity: 0.75; }
</style>
