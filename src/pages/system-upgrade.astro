---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'system-upgrade');
const { hero_tagline, intro_text, sfusd_body, productions_body, course_body, badges_body } = entry.data;
---

<BaseLayout
  title="System Upgrade"
  description="Empowering educators with innovative tools and resources to redefine learning and create impactful, future-ready education for a changing world."
>

  <!-- =====================================================================
       HERO
       ===================================================================== -->
  <section class="hero" aria-label="System Upgrade">
    <img
      class="hero__bg"
      src="/images/2021/04/20181027_115108-scaled.jpg"
      alt="Two teachers interviewed on camera in a Halloween-decorated classroom"
    />
    <div class="container hero__content">
      <h1>System Upgrade</h1>
      <p class="hero__tagline">{hero_tagline}</p>
    </div>
  </section>

  <!-- =====================================================================
       INTRO
       ===================================================================== -->
  <section class="section" aria-label="About System Upgrade">
    <div class="container">
      <h2>Redefining Education</h2>
      <hr class="accent-rule" />
      <p class="intro-text">{intro_text}</p>
    </div>
  </section>

  <!-- =====================================================================
       SHTEAM LABS ACTIVITIES
       ===================================================================== -->
  <section class="section section--alt" aria-label="SHTEAM Labs Activities">
    <div class="container">
      <div class="two-col">
        <div>
          <h2>SHTEAM Labs Activities</h2>
          <hr class="accent-rule" />
          <p>
            Documenting our journey, one lesson at a time.
          </p>
          <p>
            The SHTEAM Labs Activities Journals are our latest collection of lesson plans,
            student reflections, and activity guides. They are custom-tailored resources
            designed for particular classrooms — and you might find that they suit your
            classroom as well.
          </p>
          <a href="/shelf/" class="btn btn--primary mt-md">Browse SHTEAM Labs Resources</a>
        </div>
        <img
          src="/images/2023/09/1.png"
          alt="SHTEAM Labs activity resources"
        />
      </div>
    </div>
  </section>

  <!-- =====================================================================
       PRODUCTIONS
       ===================================================================== -->
  <section class="section" aria-label="SteamHead Productions">
    <div class="container">
      <div class="two-col two-col--reverse">
        <img
          src="/images/2021/04/20181027_115108-crop.jpg"
          alt="Teachers sharing classroom experiences during a filmed interview"
        />
        <div>
          <h2>SteamHead Productions</h2>
          <hr class="accent-rule" />
          <p>{productions_body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       ONLINE COURSE
       ===================================================================== -->
  <section class="section section--dark" aria-label="MakeFashion Edu Online Course">
    <div class="container">
      <div class="two-col">
        <div>
          <h2>MakeFashion Edu Online Course</h2>
          <hr class="accent-rule" />
          <p>{course_body}</p>
          <a href="/shelf/" class="btn btn--primary mt-md">Explore the Course</a>
        </div>
        <img
          src="/images/2021/08/GettingStartedWithMFEDU.jpg"
          alt="Getting Started with MakeFashion Edu online course"
        />
      </div>
    </div>
  </section>

  <!-- =====================================================================
       MAKERSPACE BADGES
       ===================================================================== -->
  <section class="section section--alt" aria-label="Makerspace Badges">
    <div class="container">
      <div class="two-col">
        <img
          src="/images/2024/05/badges_sm.png"
          alt="SteamHead Makerspace Badges"
        />
        <div>
          <h2>Makerspace Badges</h2>
          <hr class="accent-rule" />
          <p>{badges_body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       FAST PUBLISHING
       ===================================================================== -->
  <section class="section" aria-label="Fast Publishing">
    <div class="container">
      <h2>Fast Publishing</h2>
      <hr class="accent-rule" />
      <p class="mt-md">
        Making great things is only half the story — the other half is telling it.
        Fast Publishing is our newest experiment: we're using LLM systems to handle
        the technical side of getting blog posts written up, formatted, and published,
        so the projects and lessons coming out of our classrooms reach the community
        while the hot glue is still warm.
      </p>
      <p>
        It also means we can share educational content by publishing on our own site,
        without relying entirely on social media networks to get the word out. We find
        that genuinely exciting — and very much worth attempting. As always, a human
        reviews every post before it goes live.
      </p>
      <a href="/blog/" class="btn btn--primary mt-md">Read the Great Things Blog</a>
    </div>
  </section>

  <!-- =====================================================================
       SFUSD PARTNERSHIP
       ===================================================================== -->
  <section class="section section--alt" aria-label="SFUSD partnership">
    <div class="container">
      <h2>SteamHead &amp; the SFUSD</h2>
      <hr class="accent-rule" />
      <p class="mt-md">{sfusd_body}</p>
    </div>
  </section>

  <!-- =====================================================================
       JOIN THE COMMUNITY
       ===================================================================== -->
  <section class="section section--dark" aria-label="Join the community">
    <div class="container">
      <h2>Join the Conversation</h2>
      <hr class="accent-rule" />
      <p class="mt-md">
        Educators, did you know that Hackers are lifelong learners contributing educational
        content to their communities? Hackers, did you know teachers from Kindergarten
        through University are advocating for the skills and values in your makerspaces
        to be brought into schools?
      </p>
      <p>
        Join us online to discuss and support each other. No experience required — all
        levels of Educators and Hackers welcome.
      </p>
      <a href="/contact-us/" class="btn btn--outline mt-md">
        Get Involved
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  .intro-text {
    font-size: var(--text-xl);
    max-width: 60ch;
    line-height: 1.6;
  }
</style>
